{% doc %}
  Displays shipping information with dynamic messaging based on the shippable
  merchandise subtotal. Shows flat rate shipping and free shipping threshold. In
  cart context it also renders a decorative progress bar toward the
  free-shipping threshold plus a "You're $X away" line; the bar is aria-hidden
  because the sentence carries the state. Both the sentence and the bar count
  only line items with requires_shipping, matching what checkout evaluates. When
  vacation mode is enabled (settings.vacation_mode_enabled), appends the
  vacation shipping note (settings.vacation_shipping_message) to the text.

  With is_gift_card the snippet renders a separate email-delivery line instead:
  a gift card is emailed, never shipped, and its value does not count toward the
  free-shipping threshold at checkout.

  @param {number} [product_price] - Product price to use for calculating shipping (product page)
  @param {boolean} [cart_context] - Set to true when rendering in cart context
  @param {boolean} [is_gift_card] - Set to true for gift card products
  @example
    {% render 'shipping-info', product_price: product.price %}
    {% render 'shipping-info', cart_context: true %}
    {% render 'shipping-info', product_price: product.price, is_gift_card: true %}
{% enddoc %}

{% liquid
  # Get shipping values from theme settings (single source of truth)
  assign flat_rate_shipping = settings.flat_rate_shipping | default: '8.00'
  assign free_shipping_threshold = settings.free_shipping_threshold | default: '75.00'

  # The vacation note appends to every branch, gift card included, so it is
  # derived before the split below.
  if settings.vacation_mode_enabled
    assign vacation_note = settings.vacation_shipping_message | strip
  endif

  # Everything below is threshold work, and a gift card reads none of it: it
  # renders its own delivery line. Scoping it here keeps a later reader from
  # having to prove the arithmetic unreachable on that path.
  unless is_gift_card
    # One derivation in cents feeds both the text branch and the progress
    # bar, so they cannot disagree. Prices are already integer cents.
    assign threshold_cents = free_shipping_threshold | times: 100.0 | round

    if cart_context
      # Checkout evaluates its price-based rate conditions against the
      # shippable merchandise only. A gift card never enters a shipment, so
      # its value does not count toward the free-shipping threshold, and
      # cart.total_price (which includes it) would promise free shipping that
      # checkout will not honour on a mixed cart. Verified at checkout on
      # 2026-08-31: $65 garment + $50 gift card was charged the flat rate.
      # requires_shipping is the predicate checkout itself uses, so it also
      # covers any future non-shipping item. final_line_price is quantity- and
      # discount-aware; see release-notes.md for the discount-basis assumption.
      assign shippable_total = 0
      for item in cart.items
        if item.requires_shipping
          assign shippable_total = shippable_total | plus: item.final_line_price
        endif
      endfor
      assign remaining_cents = threshold_cents | minus: shippable_total
    elsif product_price
      assign remaining_cents = threshold_cents | minus: product_price
    endif

    if remaining_cents <= 0
      assign qualifies_for_free_shipping = true
    else
      assign qualifies_for_free_shipping = false
    endif

    # Free-shipping progress bar (cart only). Guard on positive parsed
    # cents: the setting is free text, so a cleared value or one like
    # "$75" parses to 0 and must disable the bar, not pin it at 100%
    # (and 0 cents would divide by zero below).
    assign show_shipping_progress = false
    if cart_context and threshold_cents > 0
      assign show_shipping_progress = true
      assign progress_percent = shippable_total | times: 100.0 | divided_by: threshold_cents | at_most: 100 | round
      assign remaining_amount = remaining_cents | money
    endif
  endunless
%}

{%- if is_gift_card -%}
  {%- comment -%}
    A gift card is emailed, not shipped. Saying "free shipping" here reads as a
    perk that also implies the card counts toward the free-shipping threshold,
    which checkout does not do. State the delivery method instead.
  {%- endcomment -%}
  <a href="/policies/shipping-policy" class="shipping-info">
    <svg class="shipping-info__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
      <path d="M2 4.5L8 9L14 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="shipping-info__text">
      {{- 'content.gift_card_delivery' | t -}}
      {%- if vacation_note != blank %} • {{ vacation_note }}{% endif -%}
    </span>
  </a>
{%- else -%}

  {% if show_shipping_progress %}
    <div
      class="shipping-progress{% if qualifies_for_free_shipping %} shipping-progress--complete{% endif %}"
      style="--progress: {{ progress_percent }}%"
      aria-hidden="true"
    >
      <span class="shipping-progress__fill"></span>
    </div>
  {% endif %}

  <a href="/policies/shipping-policy" class="shipping-info">
    {% if qualifies_for_free_shipping %}
      <svg class="shipping-info__icon shipping-info__icon--success" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="8" cy="8" r="7" fill="currentColor" opacity="0.15"/>
        <path d="M11.5 5.5L6.75 10.25L4.5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="shipping-info__text">
        {%- if show_shipping_progress -%}
          <strong class="shipping-info__highlight shipping-info__highlight--success">Free shipping on this order</strong>
          {%- if vacation_note != blank %}<span class="shipping-info__secondary">{{ vacation_note }}</span>{% endif %}
        {%- else -%}
          Free shipping on this order
          {%- if vacation_note != blank %} • {{ vacation_note }}{% endif %}
        {%- endif -%}
      </span>
    {% else %}
      <svg class="shipping-info__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 4.5C1 3.67157 1.67157 3 2.5 3H9.5C10.3284 3 11 3.67157 11 4.5V10.5H2.5C1.67157 10.5 1 9.82843 1 9V4.5Z" stroke="currentColor" stroke-width="1.2"/>
        <path d="M11 7H12.5L14.5 9V10.5H11V7Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        <circle cx="4" cy="12" r="1.25" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="12.5" cy="12" r="1.25" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <span class="shipping-info__text">
        {%- if show_shipping_progress -%}
          <strong class="shipping-info__highlight">{{ 'content.free_shipping_remaining' | t: amount: remaining_amount }}</strong>
          <span class="shipping-info__secondary">${{ flat_rate_shipping }} shipping within the USA{% if vacation_note != blank %} • {{ vacation_note }}{% endif %}</span>
        {%- else -%}
          ${{ flat_rate_shipping }} shipping within the USA • Free for orders over ${{ free_shipping_threshold }}
          {%- if vacation_note != blank %} • {{ vacation_note }}{% endif %}
        {%- endif -%}
      </span>
    {% endif %}
  </a>
{%- endif -%}

{% stylesheet %}
  .shipping-info {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .shipping-info:hover {
    color: var(--color-primary);
  }

  .shipping-info:hover .shipping-info__icon {
    color: var(--color-primary);
  }

  .shipping-info__icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    /* Half the foreground is well under the 3:1 an icon needs; the token is
       what every other subdued mark in the theme uses. */
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    transition: color 0.2s ease;
  }

  .shipping-info__icon--success,
  .shipping-info__highlight--success,
  .shipping-progress--complete .shipping-progress__fill {
    --shipping-success-color: #16a34a;
  }

  .shipping-info__icon--success {
    color: var(--shipping-success-color);
  }

  .shipping-info:hover .shipping-info__icon--success {
    color: #15803d;
  }

  .shipping-info__text {
    font-weight: 400;
  }

  /* Cart emphasis: the remaining-amount sentence is the call to action,
     so it gets full foreground at body size while the flat-rate detail
     drops to a subdued second line. */
  .shipping-info__highlight {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .shipping-info__highlight--success {
    color: var(--shipping-success-color, #16a34a);
  }

  .shipping-info__secondary {
    display: block;
    margin-top: 0.125rem;
  }

  .shipping-progress {
    display: block;
    /* The cart summary wraps this in a flex row, where a block div
       collapses to zero width; take the full row so the bar sits on
       its own line above the shipping sentence. */
    width: 100%;
    flex: 1 0 100%;
    margin-top: 0.75rem;
    height: 0.375rem;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    overflow: hidden;
  }

  .shipping-progress__fill {
    display: block;
    height: 100%;
    width: var(--progress, 0%);
    border-radius: inherit;
    background: var(--color-primary);
  }

  .shipping-progress--complete .shipping-progress__fill {
    background: var(--shipping-success-color);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shipping-progress__fill {
      transition: width 0.3s ease;
    }
  }
{% endstylesheet %}
