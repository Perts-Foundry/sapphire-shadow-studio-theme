{%- comment -%}Generated by scripts/notifications/brand.mjs from marketing/notifications/stock/draft_order_invoice.liquid. Do not hand-edit: change marketing/notifications/lib/ and regenerate.{%- endcomment -%}
{% capture email_title %}
  {% if payment_terms %}
    Review and confirm to complete your order
  {% else %}
    Complete your purchase
  {% endif %}
{% endcapture %}
{% capture email_body %}
  {% if item_count > 1 %}
    These items will be reserved for you until {{ reserve_inventory_until | date: format: 'date_at_time' }}.
