</tr>

      </table>
      <table class="row subtotal-table subtotal-table--total">
        
<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Return items total</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>-{{ total | abs | money_with_currency }}</strong>
  </td>
</tr>

      </table>
        {% assign refund_transactions = return.refund_transactions | default: empty %}
        {% if refund_transactions.size > 1 %}
          <table class="row subtotal-table">
            <tr><td colspan="2" class="subtotal-table__line"></td></tr>
            <tr><td colspan="2" class="subtotal-table__small-space"></td></tr>

            {% for transaction in refund_transactions %}
              {% assign amount_rounding = 0 %}
              {% if transaction.amount_rounding != 0 %}
                {% assign amount_rounding = transaction.amount_rounding %}
              {% endif %}
              {% if transaction.payment_details.gift_card_last_four_digits %}
                {% capture refund_method_subtitle %}{{ transaction.payment_details.type | replace: '_', ' ' | capitalize }}{% endcapture %}
              {% elsif transaction.payment_details.local_payment? %}
                {% capture refund_method_subtitle %}{{ transaction.payment_details.payment_method_display_name | default: transaction.payment_details.payment_method_name }}{% endcapture %}
              {% elsif transaction.payment_details.credit_card_company %}
                {% capture refund_method_subtitle %}{{ transaction.payment_details.credit_card_company }}{% endcapture %}
              {% else %}
                {% capture refund_method_subtitle %}{{ transaction.gateway_display_name | replace: '_', ' ' | capitalize }}{% endcapture %}
              {% endif %}

              {% if transaction.gateway == 'shopify_store_credit' %}
                {% assign link_url = routes.account_profile_url %}
                {% capture link_text %}View{% endcapture %}

                
<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Refund</span>
        <br>
        <small>{{ refund_method_subtitle }}</small>
          &nbsp;&nbsp;<a href="{{ link_url }}" class="small">{{ link_text }}</a>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>-{{ transaction.amount | plus: amount_rounding | abs | money_with_currency }}</strong>
  </td>
</tr>

              {% else %}
                
<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Refund</span>
        <br>
        <small>{{ refund_method_subtitle }}</small>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>-{{ transaction.amount | plus: amount_rounding | abs | money_with_currency }}</strong>
  </td>
</tr>

              {% endif %}
            {% endfor %}
          </table>
        {% endif %}
    </td>
  </tr>
</table>


            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

