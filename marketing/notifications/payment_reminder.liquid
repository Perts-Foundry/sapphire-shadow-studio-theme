{%- comment -%}Generated by scripts/notifications/brand.mjs from marketing/notifications/stock/payment_reminder.liquid. Do not hand-edit: change marketing/notifications/lib/ and regenerate.{%- endcomment -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    .body { background-color: #e1edf5; color-scheme: light only; }
    .body td, .body p, .body h1, .body h2, .body h3, .body h4, .body span, .body a { font-family: Helvetica, Arial, sans-serif; }
    .container { width: 600px; border-collapse: separate; border-left: 32px solid #ffffff; border-right: 32px solid #ffffff; }
    .header { margin: 0; }
    .shop-name__cell img { max-width: 100%; height: auto; }
    .header__cell { padding: 24px 12px 0 12px; }
    .header__cell .container { border: 28px solid #071e3f; border-left-width: 32px; border-right-width: 32px; border-radius: 4px 4px 0 0; background-color: #071e3f; }
    .header__cell .row td { display: block; width: 100%; text-align: center; }
    .shop-name__cell { display: block; text-align: center; }
    .shop-name__text { text-align: center; }
    .shop-name__text a { color: #ffffff; }
    .order-po-number__container { margin: 0 auto; }
    .order-number__cell, .po-number__cell { display: block; text-align: center; padding-top: 20px; font-size: 12px; font-weight: bold; letter-spacing: 3px; color: #3aa0e6; }
    .order-number__text, .po-number__text { display: inline-block; background-color: #0c2c56; border-radius: 4px; padding: 10px 18px; font-size: 12px; line-height: 16px; font-weight: bold; letter-spacing: 3px; color: #c9d8ea; }
    .content__cell { padding: 0 12px; border-width: 0; }
    .content__cell .container { border-top: 36px solid #ffffff; border-bottom: 8px solid #ffffff; background-color: #ffffff; }
    .section__cell { padding: 0 12px; }
    .section__cell .container { border-top: 24px solid #ffffff; border-bottom: 24px solid #ffffff; background-color: #ffffff; }
    .body p { color: #333333; font-size: 16px; line-height: 24px; }
    .body h2 { color: #071e3f; font-size: 30px; line-height: 36px; font-weight: bold; margin: 0 0 12px 0; }
    .body h3 { color: #071e3f; font-size: 20px; line-height: 26px; font-weight: bold; margin: 0 0 20px 0; }
    .body h4 { color: #0071C2; font-size: 12px; line-height: 18px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; }
    .order-list__item-title { color: #071e3f; }
    .order-list__item-variant { color: #555555; }
    .order-list__estimated-delivery { color: #555555; font-size: 14px; line-height: 20px; }
    .order-list__item-price { color: #071e3f; }
    .subtotal-line__title p { color: #555555; }
    .subtotal-table--total .subtotal-line__title p, .subtotal-table--total .subtotal-line__value strong { color: #071e3f; }
    .customer-info__item-content { color: #333333; font-size: 15px; line-height: 22px; }
    .button__cell { background: #0071C2; border-radius: 4px; }
    .actions-buttons .button__cell--primary { background-color: #0071C2; border-radius: 4px; }
    .button__text { font-weight: bold; padding: 14px 32px; }
    .button__text--shop-app { font-weight: normal; padding: 20px 25px; }
    .actions__cell { padding-bottom: 20px; }
    a, a:hover, a:active, a:visited { color: #0071C2; }
    body, .header, .content, .section { background-color: #e1edf5; }
    .footer { margin: 0; border-top-width: 0; background-color: #e1edf5; }
    .footer__cell { padding: 0 12px 24px 12px; }
    .footer__cell .container { border: 28px solid #071e3f; border-left-width: 32px; border-right-width: 32px; border-radius: 0 0 4px 4px; background-color: #071e3f; text-align: center; }
    .footer .ssb-shop-name { color: #ffffff; font-size: 14px; line-height: 20px; margin: 0 0 10px 0; text-align: center; }
    .footer .disclaimer__subtext { color: #c9d8ea; font-size: 12px; line-height: 18px; text-align: center; }
    .footer .disclaimer__subtext a, .footer .disclaimer__subtext a:hover, .footer .disclaimer__subtext a:active, .footer .disclaimer__subtext a:visited { color: #ffffff; text-decoration: underline; }
    .footer .ssb-social a, .footer .ssb-social a:hover, .footer .ssb-social a:active, .footer .ssb-social a:visited { color: #c9d8ea; }
    @media (max-width: 600px) {
      .container { table-layout: fixed !important; }
      .header { margin-top: 0 !important; margin-bottom: 0 !important; }
      .footer .ssb-social td { padding: 0 5px !important; }
    }
  </style>
</head>

<body>
  <table class="body">
    <tr>
      <td>
        <table class="header row">
  <tr>
    <td class="header__cell">
      <center>

        <table class="container">
          <tr>
            <td>

              <table class="row">
                <tr>
                  <td class="shop-name__cell">
                    {%- if shop.email_logo_url %}
                      <img src="{{shop.email_logo_url}}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}">
                    {%- else %}
                      <h1 class="shop-name__text">
                        <a href="{{shop.url}}">{{ shop.name }}</a>
                      </h1>
                    {%- endif %}
                  </td>

                    <td>
                      <table class="order-po-number__container">
                        <tr>
                          <td class="order-number__cell">
                            <span class="order-number__text">
                              Order {{ order_name }}
                            </span>
                          </td>
                        </tr>
                        {%- if po_number %}
                            <tr>
                              <td class="po-number__cell">
                                <span class="po-number__text">
                                  PO number #{{ po_number }}
                                </span>
                              </td>
                            </tr>
                        {%- endif %}
                      </table>
                    </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>

      </center>
    </td>
  </tr>
</table>

          <table class="row content">
  <tr>
    <td class="content__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              
            {% if payment_schedule.overdue? and payment_schedule.number_of_days_overdue == 0 %}
              <h2>Your payment is due today</h2>
            {% elsif payment_schedule.due_later? and payment_schedule.due_in_days == 0 %}
              <h2>Your payment is due today</h2>
            {% elsif payment_schedule.overdue? and payment_schedule.number_of_days_overdue == 1 %}
              <h2>Your payment was due yesterday</h2>
            {% elsif payment_schedule.due_later? and payment_schedule.due_in_days == 1 %}
              <h2>Your payment is due tomorrow</h2>
            {% elsif payment_schedule.due_later? and payment_schedule.due_in_days > 1 %}
              <h2>Your payment is due in {{ payment_schedule.due_in_days}} days</h2>
            {% else %}
              <h2>Your payment is {{ payment_schedule.number_of_days_overdue }} days overdue</h2>
            {% endif %}
            {% if custom_message != blank %}
              <p>{{ custom_message }}</p>
            {% else %}
              {% if payment_schedule.overdue? and payment_schedule.number_of_days_overdue == 0 %}
                <p>
                  This is a reminder that you have a payment of {{ payment_schedule.amount_due | money_with_currency }} due today for order {{ name }}.

                </p>
              {% elsif payment_schedule.due_later? %}
                <p>
                  This is a reminder that your payment of {{ payment_schedule.amount_due | money_with_currency }} for order {{ name }} is due on {{ payment_schedule.due_at | date: '%B %e, %Y' }}.

                </p>
              {% else %}
                <p>
                  This is a reminder that your payment of {{ payment_schedule.amount_due | money_with_currency }} for order {{ name }} was due on {{ payment_schedule.due_at | date: '%B %e, %Y' }}.

                </p>
              {% endif %}
              <p>
                Thank you.
              </p>
            {% endif %}
            {% if checkout_payment_collection_url %}
              <table class="row actions">
  <tr>
    <td class="actions__cell">
      <table class="button main-action-cell">
        <tr>
          <td class="button__cell"><a href="{{ checkout_payment_collection_url }}" class="button__text">Pay now</a></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

            {% endif %}

            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>
        <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              
              <table role="presentation" class="ssb-social" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 auto 18px auto;">
                <tr>
                  <td align="center" style="padding: 0 8px; white-space: nowrap;">
                    <a href="https://www.instagram.com/sapphire_shadow_studio" style="font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 28px; color: #c9d8ea; text-decoration: none;">
                      <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-instagram.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;Instagram
                    </a>
                  </td>
                  <td align="center" style="padding: 0 8px; white-space: nowrap;">
                    <a href="https://www.facebook.com/sapphireshadowstudio" style="font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 28px; color: #c9d8ea; text-decoration: none;">
                      <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-facebook.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;Facebook
                    </a>
                  </td>
                  <td align="center" style="padding: 0 8px; white-space: nowrap;">
                    <a href="https://www.tiktok.com/@sapphire_shadow_studio" style="font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 28px; color: #c9d8ea; text-decoration: none;">
                      <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-tiktok.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;TikTok
                    </a>
                  </td>
                </tr>
              </table>
              <p class="ssb-shop-name" style="margin: 0 0 10px 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #ffffff; text-align: center;">{{ shop.name }}</p>
              <p class="disclaimer__subtext">If you have any questions, reply to this email or contact us at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>.<!-- shopify-shop-marketplace-footer --></p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

<img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" class="spacer" height="1" />

      </td>
    </tr>
  </table>
</body>
</html>
