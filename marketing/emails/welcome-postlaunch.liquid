                        <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/lead2_crew-sweater_grey-heather_lpn_flat-1.jpg?width=524&amp;height=524&amp;crop=center" alt="A grey heather crewneck sweatshirt laid flat, embroidered on the chest with a first name above the letters LPN and a red heartbeat line." width="262" height="262" style="display: block; width: 100%; max-width: 262px; height: auto; margin: 0 auto; border: 0; border-radius: 4px;">
                        <span style="display: block; padding-top: 8px; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; font-weight: bold; color: #071e3f;">Lead II Crewneck</span>
                      </a>
                    </td>
                    <td width="50%" align="center" valign="top" style="padding: 0 6px 18px 6px;">
                      <a href="{{ shop.url }}/products/huddle-crewneck" style="text-decoration: none;">
                        <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/huddle_crew-sweater_black_nurse_flat-1.jpg?width=524&amp;height=524&amp;crop=center" alt="A black crewneck sweatshirt laid flat, embroidered across the chest with the word NURSE in a patterned applique." width="262" height="262" style="display: block; width: 100%; max-width: 262px; height: auto; margin: 0 auto; border: 0; border-radius: 4px;">
                        <span style="display: block; padding-top: 8px; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; font-weight: bold; color: #071e3f;">Huddle Crewneck</span>
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td width="50%" align="center" valign="top" style="padding: 0 6px 18px 6px;">
                      <a href="{{ shop.url }}/products/shift-fuel-crewneck" style="text-decoration: none;">
                        <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/shift-fuel_crew-sweater_classic-navy_flat-1.jpg?width=524&amp;height=524&amp;crop=center" alt="A navy crewneck sweatshirt laid flat, embroidered across the chest with the words powered by caffeine and trauma." width="262" height="262" style="display: block; width: 100%; max-width: 262px; height: auto; margin: 0 auto; border: 0; border-radius: 4px;">
