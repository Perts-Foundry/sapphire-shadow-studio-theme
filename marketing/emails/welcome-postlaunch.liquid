<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{{ shop.name }}</title>
    <style>
      @media only screen and (max-width: 620px) {
        .ssb-container { width: 100% !important; }
        .ssb-pad { padding-left: 20px !important; padding-right: 20px !important; }
        .ssb-h1 { font-size: 26px !important; line-height: 32px !important; }
        .ssb-button, .ssb-button td { width: 100% !important; }
        .ssb-button a { display: block !important; }
      }
