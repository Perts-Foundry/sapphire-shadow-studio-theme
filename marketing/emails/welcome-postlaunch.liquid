                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ shop.url }}/collections/all" style="height:48px;v-text-anchor:middle;width:300px;" arcsize="9%" stroke="f" fillcolor="#0071C2">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:bold;">Shop the collection</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a href="{{ shop.url }}/collections/all" style="display: inline-block; padding: 14px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 20px; font-weight: bold; color: #ffffff; text-decoration: none; border-radius: 4px; background-color: #0071C2; mso-hide: all;">
                        Shop the collection
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
