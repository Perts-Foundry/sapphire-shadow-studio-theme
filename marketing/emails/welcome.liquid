{%- comment -%}
  ==========================================================================
  TEMPLATE: Welcome / you are on the list
  SUBJECT: You are on the list
  PREVIEW TEXT: Thanks for signing up. Here is what we are making.
  SEGMENT / AUTOMATION: "Customer signs up" welcome automation (all new
    email subscribers, prelaunch and after)
  DISCOUNT CODE: none yet. If a launch code is created in Admin, uncomment
    the discount row below and put the code in it.
  LAST VERIFIED: not yet test-sent
  ==========================================================================
  Not a theme file. Pasted whole into Shopify Email's custom-code editor.
  Cloned from campaign-shell.liquid; branding is duplicated on purpose, so a
  palette change has to be made in both files. See marketing/emails/README.md.

  Deliberately says nothing specific about shipping rates, thresholds, or
  turnaround times. That copy already has four sources of truth (see the
  shipping section of the repo's CLAUDE.md) and an email is a fifth that
  nothing reconciles and that cannot be corrected once sent.
{%- endcomment -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{{ shop.name }}</title>
    <style>
      /* Media queries only. Everything else is inline, because Gmail's web
         client drops most of what a style block declares. */
      @media only screen and (max-width: 620px) {
        .ssb-container { width: 100% !important; }
        .ssb-pad { padding-left: 20px !important; padding-right: 20px !important; }
        .ssb-h1 { font-size: 26px !important; line-height: 32px !important; }
        .ssb-button a { display: block !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #e1edf5; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #e1edf5;">
      Thanks for signing up. Here is what we are making.
      &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #e1edf5;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" class="ssb-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 600px; max-width: 600px; background-color: #ffffff; border-radius: 4px;">

            <!-- Header -->
            <tr>
              <td class="ssb-pad" align="center" style="background-color: #071e3f; padding: 28px 32px; border-radius: 4px 4px 0 0;">
                <a href="{{ shop.url }}" style="color: #ffffff; text-decoration: none;">
                  <span style="font-family: Helvetica, Arial, sans-serif; font-size: 20px; line-height: 26px; font-weight: bold; letter-spacing: 1px; color: #ffffff; text-transform: uppercase;">{{ shop.name }}</span>
                </a>
              </td>
            </tr>

            <!-- Hero text -->
            <tr>
              <td class="ssb-pad" style="padding: 36px 32px 8px 32px;">
                <h1 class="ssb-h1" style="margin: 0 0 16px 0; font-family: Helvetica, Arial, sans-serif; font-size: 30px; line-height: 36px; font-weight: bold; color: #071e3f;">
                  You are on the list
                </h1>
                <p style="margin: 0 0 16px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  Hey {{ customer.first_name | default: 'friend' }},
                </p>
                <p style="margin: 0 0 16px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  Thanks for signing up. We are a small custom craft studio: a two-person,
                  husband-and-wife operation making embroidered apparel one piece at a time.
                  No mass production, no cutting corners.
                </p>
                <p style="margin: 0 0 16px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  Everything we make passes one test: would we want to own it ourselves? If the
                  answer is no, it does not make it into the shop.
                </p>
              </td>
            </tr>

            <!-- What to expect -->
            <tr>
              <td class="ssb-pad" style="padding: 8px 32px 8px 32px;">
                <h2 style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 18px; line-height: 24px; font-weight: bold; color: #071e3f;">
                  What happens next
                </h2>
                <p style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  We are still getting the shop ready. You will hear from us when it opens, and
                  after that only when there is something worth your attention: a new piece, a
                  restock, or a design we are proud of. We do not send filler.
                </p>
              </td>
            </tr>

            <!--
              Optional launch-discount row. Uncomment once the code exists in Admin,
              and replace LAUNCHCODE with the real code.
            <tr>
              <td class="ssb-pad" style="padding: 8px 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #e1edf5; border-radius: 4px;">
                  <tr>
                    <td align="center" style="padding: 20px 24px;">
                      <p style="margin: 0 0 6px 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #071e3f;">
                        Your launch-day code
                      </p>
                      <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 22px; line-height: 28px; font-weight: bold; letter-spacing: 2px; color: #071e3f;">
                        LAUNCHCODE
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            -->

            <!-- Call to action. Bulletproof button: VML for Outlook, an anchor everywhere else. -->
            <tr>
              <td class="ssb-pad" align="center" style="padding: 20px 32px 8px 32px;">
                <table role="presentation" class="ssb-button" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" bgcolor="#0071C2" style="border-radius: 4px;">
                      <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ shop.url }}/pages/about" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="9%" stroke="f" fillcolor="#0071C2">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:bold;">Meet the studio</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a href="{{ shop.url }}/pages/about" style="display: inline-block; padding: 14px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 20px; font-weight: bold; color: #ffffff; text-decoration: none; border-radius: 4px; background-color: #0071C2; mso-hide: all;">
                        Meet the studio
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Secondary text -->
            <tr>
              <td class="ssb-pad" style="padding: 16px 32px 36px 32px;">
                <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; color: #555555;">
                  Got a project in mind? Custom work is what we like best. Reply to this email and
                  tell us about it.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="ssb-pad" align="center" style="background-color: #071e3f; padding: 28px 32px; border-radius: 0 0 4px 4px;">
                <p style="margin: 0 0 10px 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #ffffff;">
                  {{ shop.name }}
                </p>
                <p style="margin: 0 0 10px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #c9d8e6;">
                  Questions? Reply to this email, or write to
                  <a href="mailto:{{ shop.email }}" style="color: #ffffff; text-decoration: underline;">{{ shop.email }}</a>.
                </p>
                <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #c9d8e6;">
                  You are getting this because you signed up at
                  <a href="{{ shop.url }}" style="color: #ffffff; text-decoration: underline;">{{ shop.domain }}</a>.
                  <a href="{{ unsubscribe_url }}" style="color: #ffffff; text-decoration: underline;">Unsubscribe</a>.
                </p>
                {{ open_tracking }}
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
