<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{{ shop.name }}</title>
    <style>
      @media only screen and (max-width: 620px) {
        .ssb-container { width: 100% !important; }
        .ssb-pad { padding-left: 20px !important; padding-right: 20px !important; }
        .ssb-h1 { font-size: 26px !important; line-height: 32px !important; }
        .ssb-button, .ssb-button td { width: 100% !important; }
        .ssb-button a { display: block !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #e1edf5; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #e1edf5;">
      The studio opens September 3 at 9:00 AM Eastern.
      &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #e1edf5;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" class="ssb-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 600px; max-width: 600px; background-color: #ffffff; border-radius: 4px;">

            <tr>
              <td class="ssb-pad" align="center" bgcolor="#071e3f" style="background-color: #071e3f; padding: 28px 32px; border-radius: 4px 4px 0 0; font-family: Helvetica, Arial, sans-serif; font-size: 20px; line-height: 26px; font-weight: bold; letter-spacing: 1px; color: #ffffff;">
                <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/SSS-Horizontal-transparent-png.png?width=480" alt="Sapphire Shadow Studio" width="240" height="89" style="display: block; width: 240px; max-width: 100%; height: auto; border: 0;">
              </td>
            </tr>

            <tr>
              <td class="ssb-pad" style="padding: 36px 32px 8px 32px;">
                <h1 class="ssb-h1" style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 30px; line-height: 36px; font-weight: bold; color: #071e3f;">
                  Thank you for subscribing to Sapphire Shadow Studio!
                </h1>
              </td>
            </tr>

            <tr>
              <td class="ssb-pad" align="center" style="padding: 8px 32px 24px 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#071e3f" style="background-color: #071e3f; border-radius: 4px;">
                  <tr>
                    <td align="center" style="padding: 24px 16px;">
                      <p style="margin: 0 0 14px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 16px; font-weight: bold; letter-spacing: 3px; text-transform: uppercase; color: #3aa0e6;">The studio opens</p>
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                        <tr>
                          <td align="center" bgcolor="#0c2c56" style="background-color: #0c2c56; padding: 14px 20px; border-radius: 4px;">
                            <span style="font-family: Helvetica, Arial, sans-serif; font-size: 24px; line-height: 28px; font-weight: bold; color: #ffffff;">Sep 3</span><br>
                            <span style="font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; letter-spacing: 1px; color: #c9d8ea;">2026</span>
                          </td>
                          <td style="width: 12px; font-size: 1px; line-height: 1px;">&nbsp;</td>
                          <td align="center" bgcolor="#0c2c56" style="background-color: #0c2c56; padding: 14px 20px; border-radius: 4px;">
                            <span style="font-family: Helvetica, Arial, sans-serif; font-size: 24px; line-height: 28px; font-weight: bold; color: #ffffff;">9:00 AM</span><br>
                            <span style="font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; letter-spacing: 1px; color: #c9d8ea;">Eastern</span>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 0;">
                <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/lead2_crew-sweater_group_flat-1.jpg?width=600&amp;height=400&amp;crop=center" alt="Three crewneck sweatshirts laid flat in black, navy and grey heather, each embroidered on the chest with a first name above a credential and a red heartbeat line." width="600" height="400" style="display: block; width: 100%; max-width: 600px; height: auto; border: 0;">
              </td>
            </tr>

            <tr>
              <td class="ssb-pad" style="padding: 32px 32px 8px 32px;">
                <h2 style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 18px; line-height: 24px; font-weight: bold; color: #071e3f;">
                  What happens next
                </h2>
                <p style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  Thanks for signing up before there is anything to buy. That is the part we
                  appreciate most, honestly.
                </p>
                <p style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  Sapphire Shadow Studio is a small custom craft studio. We are Maddie and Seth,
                  a husband-and-wife team making embroidered apparel one piece at a time. No mass
                  production, no cutting corners, just pieces we would want to own ourselves.
                </p>
                <p style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  Until then we are finishing pieces, shooting photos, and getting the last details
                  right. The date above is the one we are working to, and it is the same one counting
                  down on the site.
                </p>
                <p style="margin: 0 0 12px 0; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
                  When the doors open, this list hears first. That is the whole point of it. Until
                  then we will leave your inbox alone: we write when there is something real to
                  show you, and not otherwise.
                </p>
              </td>
            </tr>

            <tr>
              <td class="ssb-pad" align="center" style="padding: 20px 32px 36px 32px;">
                <table role="presentation" class="ssb-button" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" bgcolor="#0071C2" style="border-radius: 4px;">
                      <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://www.instagram.com/sapphire_shadow_studio" style="height:48px;v-text-anchor:middle;width:300px;" arcsize="9%" stroke="f" fillcolor="#0071C2">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:bold;">See what we are making</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a href="https://www.instagram.com/sapphire_shadow_studio" style="display: inline-block; padding: 14px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 20px; font-weight: bold; color: #ffffff; text-decoration: none; border-radius: 4px; background-color: #0071C2; mso-hide: all;">
                        See what we are making
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>
                <p style="margin: 12px 0 0 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #555555;">
                  Works in progress, finished pieces, and the occasional studio cat.
                </p>
              </td>
            </tr>

            <tr>
              <td class="ssb-pad" align="center" bgcolor="#071e3f" style="background-color: #071e3f; padding: 28px 32px; border-radius: 0 0 4px 4px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 0 18px 0;">
                  <tr>
                    <td align="center" style="padding: 0 8px; white-space: nowrap;">
                      <a href="https://www.instagram.com/sapphire_shadow_studio" style="font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 28px; color: #c9d8ea; text-decoration: none;">
                        <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-instagram.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;Instagram
                      </a>
                    </td>
                    <td align="center" style="padding: 0 8px; white-space: nowrap;">
                      <a href="https://www.facebook.com/sapphireshadowstudio" style="font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 28px; color: #c9d8ea; text-decoration: none;">
                        <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-facebook.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;Facebook
                      </a>
                    </td>
                    <td align="center" style="padding: 0 8px; white-space: nowrap;">
                      <a href="https://www.tiktok.com/@sapphire_shadow_studio" style="font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 28px; color: #c9d8ea; text-decoration: none;">
                        <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-tiktok.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;TikTok
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="margin: 0 0 10px 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #ffffff;">
                  {{ shop.name }}
                </p>
                <p style="margin: 0 0 10px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #c9d8ea;">
                  Questions? Reply to this email, or write to
                  <a href="mailto:contact@sapphireshadowstudio.com" style="color: #ffffff; text-decoration: underline;">contact@sapphireshadowstudio.com</a>.
                </p>
                <p style="margin: 0 0 10px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #c9d8ea;">
                  Add us to your contacts, so the note about opening day lands in your inbox and not
                  somewhere you never look.
                </p>
                <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #c9d8ea;">
                  You are getting this because you asked to hear from {{ shop.domain }} when it opens.
                  <a href="{{ unsubscribe_url }}" style="color: #ffffff; text-decoration: underline;">Unsubscribe</a>.
                </p>
                {{ open_tracking }}
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
