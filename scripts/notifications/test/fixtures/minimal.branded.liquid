{%- comment -%}Generated by scripts/notifications/brand.mjs from marketing/notifications/stock/minimal.liquid. Do not hand-edit: change marketing/notifications/lib/ and regenerate.{%- endcomment -%}
{% assign has_note = false %}
{% if note != blank %}
  {% assign has_note = true %}
{% endif %}
{% capture email_title %}Thank you for your purchase!{% endcapture %}
{% capture email_body %}
  {% if has_note %}
    <p>We’ve noted your request: “{{ note }}”.</p>
  {% else %}
    <p>We’re getting your order ready to be shipped.</p>
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="en">
  <head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    .body { background-color: #e1edf5; }
    .button__cell { background: #0071C2; border-radius: 4px; }
    .actions-buttons .button__cell--primary { background-color: #0071C2; border-radius: 4px; }
    a, a:hover, a:active, a:visited { color: #0071C2; }
    .body .disclaimer__subtext { color: #c9d8ea; font-size: 12px; line-height: 18px; text-align: center; }
    .ssb-social a, .ssb-social a:hover, .ssb-social a:active, .ssb-social a:visited { color: #c9d8ea; }
  </style>
</head>

  <body>
    <table class="body">
      <tr>
        <td>
          <table class="header row">
  <tr>
    <td class="header__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              <table class="row">
                <tr>
                  <td class="shop-name__cell">
                    <h1 class="shop-name__text">
                      <a href="{{ shop.url }}">{{ shop.name }}</a>
                    </h1>
                  </td>
                  <td class="order-number__cell">
                    <span class="order-number__text">Order {{ order_name }}</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

          <table class="row content">
  <tr>
    <td class="content__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              <h2>{{ email_title }}</h2>
              {{ email_body }}
              <table class="row actions">
                <tr>
                  <td class="actions__cell">
                    <table class="button main-action-cell">
                      <tr>
                        <td class="button__cell"><a href="{{ order_status_url }}" class="button__text">View your order</a></td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
              <p>Thread colour: 🧵 Sapphire blue (#1).</p>
              <p>Every piece is made to order, so allow 2 to 4 weeks. Questions? Just reply.</p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

          <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container">
          <tr>
            <td>

              <table role="presentation" class="ssb-social" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 auto 18px auto;">
                <tr>
                  <td align="center" style="padding: 0 8px; white-space: nowrap;">
                    <a href="https://www.instagram.com/sapphire_shadow_studio" style="color: #c9d8ea; text-decoration: none;">
                      <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-instagram.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;Instagram
                    </a>
                  </td>
                  <td align="center" style="padding: 0 8px; white-space: nowrap;">
                    <a href="https://www.tiktok.com/@sapphire_shadow_studio" style="color: #c9d8ea; text-decoration: none;">
                      <img src="https://cdn.shopify.com/s/files/1/0958/0874/9868/files/email-icon-tiktok.png" alt="" width="28" height="28" style="border: 0; vertical-align: middle;">&nbsp;TikTok
                    </a>
                  </td>
                </tr>
              </table>
              <p class="ssb-shop-name" style="margin: 0 0 10px 0; color: #ffffff; text-align: center;">{{ shop.name }}</p>
              <p class="disclaimer__subtext">If you have any questions, reply to this email or contact us at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>. © {{ 'now' | date: '%Y' }} {{ shop.name }}.</p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

<img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" class="spacer" height="1" />

        </td>
      </tr>
    </table>
  </body>
</html>
