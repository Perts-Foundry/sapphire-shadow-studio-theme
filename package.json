{
  "name": "sapphire-shadow-studio-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Custom Shopify theme based on Horizon. CI tooling pinned via @shopify/cli devDependency.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "shopify": "shopify",
    "theme:check": "shopify theme check",
    "theme:dev": "shopify theme dev",
    "lib:test": "node --test scripts/lib/*.test.mjs",
    "images:test": "node --test scripts/*.test.mjs",
    "smoke:test": "node --test .github/actions/shopify-theme-push/smoke.test.mjs .github/actions/shopify-theme-push/report-format.test.mjs .github/actions/shopify-theme-push/check-push-rejections.test.mjs .github/actions/shopify-theme-push/retry.test.mjs",
    "size-chart:test": "node --test scripts/size-chart/test/*.test.mjs",
    "blank-inventory:test": "node --test scripts/blank-inventory/test/*.test.mjs",
    "seo-review:test": "node --test scripts/seo-review/test/*.test.mjs",
    "site-check:test": "node --test scripts/site-check/test/*.test.mjs",
    "contrast:test": "node --test scripts/contrast/test/*.test.mjs",
    "contrast:lint": "node scripts/contrast/check-contrast.mjs",
    "a11y:test": "node --test scripts/a11y/test/*.test.mjs",
    "blank-inventory:guard": "node scripts/blank-inventory/check-no-real-blank-ids.mjs",
    "sku:test": "node --test scripts/sku/test/*.test.mjs",
    "sku:tables": "node scripts/sku/check-tables.mjs",
    "catalogue:test": "node --test scripts/catalogue/test/*.test.mjs",
    "catalogue:lint": "node scripts/catalogue/check-catalogue.mjs",
    "size-chart:golden:update": "node scripts/size-chart/test/regen-golden.mjs",
    "applique-grid:test": "node --test scripts/applique-grid/test/*.test.mjs",
    "applique-grid:golden:update": "node scripts/applique-grid/test/regen-golden.mjs",
    "email-icons:test": "node --test scripts/email-icons/test/*.test.mjs",
    "notifications:generate": "node scripts/notifications/brand.mjs",
    "notifications:check": "node scripts/notifications/brand.mjs --check",
    "notifications:test": "node --test scripts/notifications/test/*.test.mjs",
    "policies:check": "node scripts/policies/check.mjs",
    "policies:pull": "node scripts/policies/pull.mjs",
    "policies:restamp": "node scripts/policies/restamp.mjs",
    "policies:push": "node scripts/policies/push.mjs",
    "policies:status": "node scripts/policies/status.mjs",
    "policies:verify": "node scripts/policies/verify.mjs",
    "policies:test": "node --test scripts/policies/test/*.test.mjs",
    "policies:coverage": "node --test --experimental-test-coverage --test-coverage-branches=80 --test-coverage-include=scripts/policies/**/*.mjs --test-coverage-exclude=scripts/policies/test/**  scripts/policies/test/*.test.mjs",
    "images:enhance": "node scripts/enhance-product-images.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "4.7.0",
    "heic-decode": "2.1.0",
    "pa11y-ci": "4.1.1",
    "sharp": "0.35.4"
  }
}
