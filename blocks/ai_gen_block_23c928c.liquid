{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-about-hero-{{ ai_gen_id }} {
    padding: 60px 20px;
    text-align: center;
    background-color: {{ block.settings.hero_bg_color }};
    margin-bottom: 20px;
  }

  .ai-about-hero-content-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-about-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    color: {{ block.settings.hero_text_color }};
    margin: 0 0 20px;
    font-weight: 700;
  }

  .ai-about-hero-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_text_size }}px;
    color: {{ block.settings.hero_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-about-section-{{ ai_gen_id }} {
    padding: 20px 20px;
    margin-bottom: 20px;
  }

  .ai-about-section-content-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-about-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    text-align: center;
    font-weight: 700;
  }

  .ai-about-mission-{{ ai_gen_id }} {
    background-color: {{ block.settings.mission_bg_color }};
  }

  .ai-about-mission-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-about-values-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }

  .ai-about-value-card-{{ ai_gen_id }} {
    padding: 30px;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    text-align: center;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-about-value-icon-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
  }

  .ai-about-value-icon-{{ ai_gen_id }} svg {
    width: 30px;
    height: 30px;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-about-value-title-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-about-value-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-about-team-carousel-{{ ai_gen_id }} {
    position: relative;
    margin-top: 40px;
    max-width: 400px;
    margin-inline: auto;
  }

  .ai-about-team-carousel-track-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-about-team-member-{{ ai_gen_id }} {
    text-align: center;
    opacity: 0;
    visibility: hidden;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .ai-about-team-member-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  .ai-about-team-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    /*
     * 12px, not 10px, and the two pixels are load-bearing. WCAG 2.5.8 passes a
     * target under 24px when no neighbouring target's 24px circle overlaps its
     * own, which for a 12px dot means centres at least 24px apart: 12 + 12.
     * At 10px the centres were 22px apart and every dot failed target-size.
     * Widening the gap keeps the dots themselves 12px, where enlarging the
     * buttons to 24px would have spread the row visibly.
     */
    gap: 12px;
    margin-top: 20px;
  }

  .ai-about-team-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.text_color }};
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-about-team-dot-{{ ai_gen_id }}:hover,
  .ai-about-team-dot-{{ ai_gen_id }}.active {
    background: {{ block.settings.text_color }};
  }

  .ai-about-team-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: {{ block.settings.team_image_radius }}px;
  }

  .ai-about-team-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-about-team-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-about-team-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-about-team-name-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.text_color }};
    margin: 0 0 5px;
    font-weight: 600;
  }

  .ai-about-team-role-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0 0 10px;
  }

  .ai-about-team-bio-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-about-story-{{ ai_gen_id }} {
    background-color: {{ block.settings.story_bg_color }};
  }

  .ai-about-story-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-about-story-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: {{ block.settings.story_image_radius }}px;
  }

  .ai-about-story-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-about-story-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-about-story-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .ai-about-story-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
  }

  @media screen and (max-width: 768px) {
    .ai-about-hero-{{ ai_gen_id }} {
      padding: 40px 20px;
      margin-bottom: 20px;
    }

    .ai-about-hero-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_title_size }}px * 0.7);
    }

    .ai-about-section-{{ ai_gen_id }} {
      padding: 20px 20px;
      margin-bottom: 20px;
    }

    .ai-about-section-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.section_title_size }}px * 0.8);
    }

    .ai-about-values-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-about-team-carousel-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-about-story-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
{% endstyle %}

<div class="ai-about-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_hero %}
    <div class="ai-about-hero-{{ ai_gen_id }}">
      <div class="ai-about-hero-content-{{ ai_gen_id }}">
        {% if block.settings.hero_title != blank %}
          <h1 class="ai-about-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
        {% endif %}
        {% if block.settings.hero_text != blank %}
          <div class="ai-about-hero-text-{{ ai_gen_id }}">{{ block.settings.hero_text }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_mission %}
    <div class="ai-about-section-{{ ai_gen_id }} ai-about-mission-{{ ai_gen_id }}">
      <div class="ai-about-section-content-{{ ai_gen_id }}">
        {% if block.settings.mission_title != blank %}
          <h2 class="ai-about-section-title-{{ ai_gen_id }}">{{ block.settings.mission_title }}</h2>
        {% endif %}
        {% if block.settings.mission_text != blank %}
          <div class="ai-about-mission-text-{{ ai_gen_id }}">{{ block.settings.mission_text }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_values %}
    <div class="ai-about-section-{{ ai_gen_id }}">
      <div class="ai-about-section-content-{{ ai_gen_id }}">
        {% if block.settings.values_title != blank %}
          <h2 class="ai-about-section-title-{{ ai_gen_id }}">{{ block.settings.values_title }}</h2>
        {% endif %}
        <div class="ai-about-values-grid-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% liquid
              assign value_title_key = 'value_' | append: i | append: '_title'
              assign value_text_key = 'value_' | append: i | append: '_text'
              assign value_title = block.settings[value_title_key]
              assign value_text = block.settings[value_text_key]
            %}
            {% if value_title != blank or value_text != blank %}
              <div class="ai-about-value-card-{{ ai_gen_id }}">
                <div class="ai-about-value-icon-{{ ai_gen_id }}">
                  {% case i %}
                    {% when 1 %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% when 2 %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      </svg>
                    {% when 3 %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                      </svg>
                    {% when 4 %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                      </svg>
                  {% endcase %}
                </div>
                {% if value_title != blank %}
                  <h3 class="ai-about-value-title-{{ ai_gen_id }}">{{ value_title }}</h3>
                {% endif %}
                {% if value_text != blank %}
                  <div class="ai-about-value-text-{{ ai_gen_id }}">{{ value_text }}</div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_story %}
    <div class="ai-about-section-{{ ai_gen_id }} ai-about-story-{{ ai_gen_id }}">
      <div class="ai-about-section-content-{{ ai_gen_id }}">
        {% if block.settings.story_title != blank %}
          <h2 class="ai-about-section-title-{{ ai_gen_id }}">{{ block.settings.story_title }}</h2>
        {% endif %}
        <div class="ai-about-story-content-{{ ai_gen_id }}">
          <div class="ai-about-story-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.story_image %}
              <img
                src="{{ block.settings.story_image | image_url: width: 800 }}"
                alt="{{ block.settings.story_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.story_image.width }}"
                height="{{ block.settings.story_image.height }}"
                class="ai-about-story-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-about-story-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div>
            {% if block.settings.story_text != blank %}
              <div class="ai-about-story-text-{{ ai_gen_id }}">{{ block.settings.story_text }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_team %}
    <div class="ai-about-section-{{ ai_gen_id }}">
      <div class="ai-about-section-content-{{ ai_gen_id }}">
        {% if block.settings.team_title != blank %}
          <h2 class="ai-about-section-title-{{ ai_gen_id }}">{{ block.settings.team_title }}</h2>
        {% endif %}
        <div class="ai-about-team-carousel-{{ ai_gen_id }}" data-rotation-speed="{{ block.settings.team_rotation_speed | default: 5 }}">
          <div class="ai-about-team-carousel-track-{{ ai_gen_id }}">
            {% for i in (1..3) %}
              {% liquid
                assign member_image_key = 'team_member_' | append: i | append: '_image'
                assign member_name_key = 'team_member_' | append: i | append: '_name'
                assign member_role_key = 'team_member_' | append: i | append: '_role'
                assign member_bio_key = 'team_member_' | append: i | append: '_bio'
                assign member_image = block.settings[member_image_key]
                assign member_name = block.settings[member_name_key]
                assign member_role = block.settings[member_role_key]
                assign member_bio = block.settings[member_bio_key]
              %}
              {% if member_name != blank or member_role != blank or member_bio != blank %}
                <div class="ai-about-team-member-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
                  <div class="ai-about-team-image-wrapper-{{ ai_gen_id }}">
                    {% if member_image %}
                      <img
                        src="{{ member_image | image_url: width: 400 }}"
                        alt="{{ member_image.alt | escape }}"
                        loading="lazy"
                        width="{{ member_image.width }}"
                        height="{{ member_image.height }}"
                        class="ai-about-team-image-{{ ai_gen_id }}"
                      >
                    {% else %}
                      <div class="ai-about-team-placeholder-{{ ai_gen_id }}">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  {% if member_name != blank %}
                    <h3 class="ai-about-team-name-{{ ai_gen_id }}">{{ member_name }}</h3>
                  {% endif %}
                  {% if member_role != blank %}
                    <div class="ai-about-team-role-{{ ai_gen_id }}">{{ member_role }}</div>
                  {% endif %}
                  {% if member_bio != blank %}
                    <div class="ai-about-team-bio-{{ ai_gen_id }}">{{ member_bio }}</div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="ai-about-team-dots-{{ ai_gen_id }}">
            {% for i in (1..3) %}
              <button class="ai-about-team-dot-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View team member {{ i }}"></button>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<script>
  (function() {
    const carousel = document.querySelector('.ai-about-team-carousel-{{ ai_gen_id }}');
    if (!carousel) return;

    const members = carousel.querySelectorAll('.ai-about-team-member-{{ ai_gen_id }}');
    const dots = carousel.querySelectorAll('.ai-about-team-dot-{{ ai_gen_id }}');
    const rotationSpeed = parseInt(carousel.dataset.rotationSpeed, 10) * 1000 || 5000;
    let currentIndex = 0;
    let intervalId;

    function showMember(index) {
      members.forEach((member, i) => {
        member.classList.toggle('active', i === index);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
      });
      currentIndex = index;
    }

    function nextMember() {
      const nextIndex = (currentIndex + 1) % members.length;
      showMember(nextIndex);
    }

    function startRotation() {
      intervalId = setInterval(nextMember, rotationSpeed);
    }

    function stopRotation() {
      clearInterval(intervalId);
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopRotation();
        showMember(index);
        startRotation();
      });
    });

    carousel.addEventListener('mouseenter', stopRotation);
    carousel.addEventListener('mouseleave', startRotation);

    if (typeof Shopify !== 'undefined' && Shopify.designMode) {
      document.addEventListener('shopify:section:load', () => {
        stopRotation();
        startRotation();
      });
    }

    startRotation();
  })();
</script>

