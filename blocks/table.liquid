{% doc %}
  A self-contained table block for displaying structured data such as size charts.
  Supports 2, 3, or 4 columns with optional header row and alternating row colors.
  Rows with all-blank cells are automatically hidden.

  @example
  {% content_for 'block', type: 'table', id: 'size-chart' %}
{% enddoc %}

{% liquid
  assign col_count = block.settings.column_count
  assign stripe_class = ''
  if block.settings.stripe_rows
    assign stripe_class = ' table-block--striped'
  endif
%}

<figure
  class="table-block{{ stripe_class }}"
  data-columns="{{ col_count }}"
  {{ block.shopify_attributes }}
>
  <div class="table-block__scroll">
    <table class="table-block__table">
      {% if block.settings.show_header %}
        <thead>
          <tr class="table-block__row">
            <th class="table-block__cell table-block__cell--header" scope="col">{{ block.settings.col1_heading }}</th>
            <th class="table-block__cell table-block__cell--header" scope="col">{{ block.settings.col2_heading }}</th>
            <th class="table-block__cell table-block__cell--header" scope="col">{{ block.settings.col3_heading }}</th>
            <th class="table-block__cell table-block__cell--header" scope="col">{{ block.settings.col4_heading }}</th>
            <th class="table-block__cell table-block__cell--header" scope="col">{{ block.settings.col5_heading }}</th>
            <th class="table-block__cell table-block__cell--header" scope="col">{{ block.settings.col6_heading }}</th>
          </tr>
        </thead>
      {% endif %}
      <tbody>
        {% unless block.settings.r1c1 == blank and block.settings.r1c2 == blank and block.settings.r1c3 == blank and block.settings.r1c4 == blank and block.settings.r1c5 == blank and block.settings.r1c6 == blank %}
          <tr class="table-block__row">
            <td class="table-block__cell">{{ block.settings.r1c1 }}</td>
            <td class="table-block__cell">{{ block.settings.r1c2 }}</td>
            <td class="table-block__cell">{{ block.settings.r1c3 }}</td>
            <td class="table-block__cell">{{ block.settings.r1c4 }}</td>
            <td class="table-block__cell">{{ block.settings.r1c5 }}</td>
            <td class="table-block__cell">{{ block.settings.r1c6 }}</td>
          </tr>
        {% endunless %}
        {% unless block.settings.r2c1 == blank and block.settings.r2c2 == blank and block.settings.r2c3 == blank and block.settings.r2c4 == blank and block.settings.r2c5 == blank and block.settings.r2c6 == blank %}
          <tr class="table-block__row">
            <td class="table-block__cell">{{ block.settings.r2c1 }}</td>
            <td class="table-block__cell">{{ block.settings.r2c2 }}</td>
            <td class="table-block__cell">{{ block.settings.r2c3 }}</td>
            <td class="table-block__cell">{{ block.settings.r2c4 }}</td>
            <td class="table-block__cell">{{ block.settings.r2c5 }}</td>
            <td class="table-block__cell">{{ block.settings.r2c6 }}</td>
          </tr>
        {% endunless %}
        {% unless block.settings.r3c1 == blank and block.settings.r3c2 == blank and block.settings.r3c3 == blank and block.settings.r3c4 == blank and block.settings.r3c5 == blank and block.settings.r3c6 == blank %}
          <tr class="table-block__row">
            <td class="table-block__cell">{{ block.settings.r3c1 }}</td>
            <td class="table-block__cell">{{ block.settings.r3c2 }}</td>
            <td class="table-block__cell">{{ block.settings.r3c3 }}</td>
            <td class="table-block__cell">{{ block.settings.r3c4 }}</td>
            <td class="table-block__cell">{{ block.settings.r3c5 }}</td>
            <td class="table-block__cell">{{ block.settings.r3c6 }}</td>
          </tr>
        {% endunless %}
        {% unless block.settings.r4c1 == blank and block.settings.r4c2 == blank and block.settings.r4c3 == blank and block.settings.r4c4 == blank and block.settings.r4c5 == blank and block.settings.r4c6 == blank %}
