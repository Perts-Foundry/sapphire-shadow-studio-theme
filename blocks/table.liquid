            <td class="table-block__cell">{{ block.settings.r7c4 }}</td>
            <td class="table-block__cell">{{ block.settings.r7c5 }}</td>
            <td class="table-block__cell">{{ block.settings.r7c6 }}</td>
          </tr>
        {% endunless %}
        {% unless block.settings.r8c1 == blank and block.settings.r8c2 == blank and block.settings.r8c3 == blank and block.settings.r8c4 == blank and block.settings.r8c5 == blank and block.settings.r8c6 == blank %}
