            <td class="table-block__cell">{{ block.settings.r8c5 }}</td>
            <td class="table-block__cell">{{ block.settings.r8c6 }}</td>
          </tr>
        {% endunless %}
      </tbody>
    </table>
  </div>
</figure>

{% stylesheet %}
  .table-block {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    max-width: 100%;
    min-width: 0;
  }

  .table-block__scroll {
    overflow-x: auto;
    max-width: 100%;
  }

  .table-block__table {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
  }

  .table-block__cell {
    padding-block: 0.8rem;
    padding-inline: 1.1rem;
    border-block-end: 1px solid var(--color-border);
    border-inline-end: 1px solid var(--color-border);
    text-align: start;
    white-space: nowrap;
  }

  .table-block__cell:last-child {
    border-inline-end: none;
  }

  .table-block__cell--header {
    font-weight: 600;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }

  .table-block__row:last-child .table-block__cell {
    border-block-end: none;
  }

  [data-columns="2"] .table-block__cell:nth-child(n+3) {
    display: none;
  }

  [data-columns="3"] .table-block__cell:nth-child(n+4) {
    display: none;
  }

  [data-columns="4"] .table-block__cell:nth-child(n+5) {
    display: none;
  }

  [data-columns="5"] .table-block__cell:nth-child(n+6) {
    display: none;
  }

  .table-block--striped tbody .table-block__row:nth-child(even) .table-block__cell {
    background-color: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
{% endstylesheet %}

