          </tr>
        {% endunless %}
        {% unless block.settings.r5c1 == blank and block.settings.r5c2 == blank and block.settings.r5c3 == blank and block.settings.r5c4 == blank and block.settings.r5c5 == blank and block.settings.r5c6 == blank %}
