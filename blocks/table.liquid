            <td class="table-block__cell">{{ block.settings.r6c3 }}</td>
            <td class="table-block__cell">{{ block.settings.r6c4 }}</td>
            <td class="table-block__cell">{{ block.settings.r6c5 }}</td>
            <td class="table-block__cell">{{ block.settings.r6c6 }}</td>
          </tr>
        {% endunless %}
        {% unless block.settings.r7c1 == blank and block.settings.r7c2 == blank and block.settings.r7c3 == blank and block.settings.r7c4 == blank and block.settings.r7c5 == blank and block.settings.r7c6 == blank %}
