    "custom_faq": {
      "type": "faq",
      "blocks": {
        "faq_preview": {
          "type": "faq_item",
          "settings": {
            "question": "Can I see a preview before you start?",
            "answer": "<p>Yes. For fully custom designs we send a digitized mockup before any thread hits fabric. For simple personalizations (names, dates), we confirm in writing instead.</p>",
            "custom_anchor": ""
          }
        },
        "faq_changes": {
          "type": "faq_item",
          "settings": {
            "question": "Can I make changes after I approve?",
            "answer": "<p>Small tweaks before we start production, sure. Once we've started embroidering, changes mean starting over and a new charge.</p>",
            "custom_anchor": ""
          }
        },
        "faq_refundable": {
          "type": "faq_item",
          "settings": {
            "question": "Are custom orders refundable?",
            "answer": "<p>Custom pieces are final sale. They're made specifically for you and we can't resell them. We send mockups for approval so you know what you're getting. See our <a href=\"/policies/refund-policy\" target=\"_blank\" rel=\"noopener noreferrer\">Refund Policy</a> for the full picture.</p>",
            "custom_anchor": ""
          }
        },
        "faq_bulk": {
          "type": "faq_item",
          "settings": {
            "question": "Do you do bulk or team orders?",
            "answer": "<p>Yes. Small-batch is our happy place. Reach out with your quantity, target date, and design idea.</p>",
            "custom_anchor": ""
          }
        },
        "faq_wont_do": {
          "type": "faq_item",
          "settings": {
            "question": "What won't you do?",
            "answer": "<p>We won't reproduce trademarked logos or copyrighted designs you don't own the rights to, and we won't take on projects that conflict with our values. Beyond that, ask.</p>",
            "custom_anchor": ""
          }
        }
      },
      "block_order": [
