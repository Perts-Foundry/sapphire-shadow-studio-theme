                "accordion_row_ci001": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Care Instructions",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_ci001": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Always follow the care instructions on your garment's tag, when in doubt, the tag wins. The guidelines below apply to most cases and will keep your vest and embroidery looking sharp for years to come.</p><ul><li>Machine wash cold, separately.</li><li>Only non-chlorine bleach when needed.</li><li>Tumble dry on low heat.</li><li>Cool iron if necessary, never directly on embroidery.</li></ul>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
