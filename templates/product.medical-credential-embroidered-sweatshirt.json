                },
                "accordion_row_st001": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Shipping & Turnaround",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_st001": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Most orders arrive within 7-10 business days total, we need about 2 business days to create your piece, then economy shipping takes 5-8 business days.<br/><br/>Need it faster? Expedited shipping gets it to you in 3-4 business days total.<br/><br/>Check out our <a href=\"/policies/shipping-policy\" title=\"Shipping Policy\">Shipping Policy</a> for all the details!</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
