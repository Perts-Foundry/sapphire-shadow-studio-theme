                "accordion_row_ci001": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Care Instructions",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_ci001": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Always follow the care instructions on your shirt's tag, when in doubt, the tag wins. The guidelines below apply to most cases and will keep your sweatshirt and embroidery looking sharp for years to come.</p><ul><li>Machine wash cold, inside out, on a gentle cycle.</li><li>Do not bleach.</li><li>Tumble dry on low heat or hang to dry.</li><li>Do not iron directly on embroidery.</li></ul>",
                        "width": "100%",
