<script
  src="{{ 'policy-nav.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="policy spacing-style"
    style="
      --policy-gap: {{ section.settings.gap }}px;
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <h1 class="policy__title">{{ policy.title }}</h1>

    <policy-nav-component class="policy__nav-host">
      {%- comment -%}
        The nav shell is rendered server-side so its heading can come from a
        locale key; policy-nav.js only fills the list and unhides it. Without
        JS the shell stays hidden and the page reads fine.
      {%- endcomment -%}
      <nav
        class="policy__nav"
        aria-labelledby="PolicyNavHeading-{{ section.id }}"
        ref="nav"
        hidden
      >
        <h2 class="policy__nav-heading" id="PolicyNavHeading-{{ section.id }}">
          {{- 'policy.on_this_page' | t -}}
        </h2>
        <ul class="policy__nav-list" ref="list"></ul>
      </nav>

      {%- comment -%}
        Keep the `rte` class: it is what supplies the shared branded table,
        list and blockquote styles from assets/base.css.
      {%- endcomment -%}
      <div class="policy__content policy-content rte" ref="content">
        {{ policy.body }}
      </div>
    </policy-nav-component>
  </div>
</div>

{% stylesheet %}
  .policy {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    padding-inline: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--policy-gap, 32px);
  }

  /* The custom element is a layout no-op; the flex column above owns spacing. */
  .policy__nav-host {
    display: contents;
  }

  .policy__title {
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    text-align: center;
    margin-block: 0;
  }

  .policy__nav[hidden] {
    display: none;
  }

  .policy__nav {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 20px 24px;
  }

  .policy__nav-heading {
    font-family: var(--font-heading--family);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-foreground-heading);
    opacity: 0.75;
    margin-block: 0 12px;
  }

  .policy__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .policy__nav-link {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .policy__nav-link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .policy-content :is(h2, h3, h4, h5, h6) {
    /* Clear the sticky header plus announcement bar when deep-linked.
       Kept in step with the same offset in sections/faq.liquid. */
    scroll-margin-top: 150px;
  }

  .policy-content hr {
    border: 0;
    border-block-start: 1px solid var(--color-border);
    margin-block: 48px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
