<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="border-style"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {%  render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      {% content_for 'blocks' %}

      {%- comment -%}
        Horizon renders `shop.password_message` here. It is dropped on purpose:
        the Admin value is a leftover "Site Under Maintenance!" that contradicts
        the countdown sitting directly above it, and the gate now says what it
        needs to say in the blocks. Clearing the Admin field instead
        (Online Store > Preferences > password page) would be the tidier fix and
        would let this render come back; nothing here depends on it being gone.
      {%- endcomment -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-password {
    flex-grow: 1;
    display: flex;
  }

  /*
   * "Follow us" heading above the social pills, emitted by the `follow_heading`
   * custom-liquid block in templates/password.json.
   *
   * Modelled on `.launch-countdown__eyebrow` rather than the homepage
   * `.hero-lockup`: that lockup's CSS and its self-hosted Dancing Script live in
   * sections/hero.liquid, which the password page never renders, and
   * blocks/launch-countdown.liquid records that the font's duplicated @font-face
   * and 42 KB preload were dropped from this page on purpose. Tracked caps in
   * the heading font also read as one voice with the countdown above.
   *
   * The countdown sizes its eyebrow in em off its own `--font-h1--size` root;
   * this heading has no such wrapper, so the same ratios are re-expressed
   * against `--font-h1--size` directly. The star size and gap are the
   * countdown's 0.6em and 0.35em of h1 restated against the smaller eyebrow
   * size (0.6 / 0.36 and 0.35 / 0.36).
   */
  .password-follow__heading {
    /*
     * Deliberately not flex, for the reason the countdown eyebrow documents:
     * as flex items the stars are pushed to the far edges as soon as the text
     * wraps. Inline stars wrap with the words instead.
     */
    display: block;
    margin-block: var(--margin-5xl) 0;
    font-size: calc(var(--font-h1--size) * 0.36);
    font-weight: 400;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    text-wrap: balance;
    text-align: center;
    opacity: var(--opacity-85);
    color: var(--color-foreground-heading);
  }

  .password-follow__star {
    display: inline-block;
    vertical-align: middle;
    margin-inline: 0.97em;
    line-height: 0;
    /*
     * Inherited rather than set to the pill accent the homepage `.follow-lockup`
     * uses: against this page's navy that blue read as a near-miss of the pills
     * below rather than a match, so the stars take the heading's own foreground,
     * the way `.launch-countdown__star` does directly above.
     */
    color: inherit;
  }

  .password-follow__star svg {
    display: block;
    width: 1.65em;
    height: 1.65em;
  }

  /*
   * The newsletter line's size is a block setting with no mobile variant, and
   * `typography-style` writes it as an inline `--font-size`, so the override
   * has to target the consuming `font-size` declaration rather than the custom
   * property. `.section-password .text-block.custom-font-size` outranks the
   * theme's own `.custom-font-size` without needing !important.
   *
   * The password page has exactly one text block today. If a second is ever
   * added this rule will catch it too, which is the trade for not hardcoding a
   * block id.
   */
  @media screen and (max-width: 749px) {
    .section-password .text-block.custom-font-size {
      font-size: 0.95rem;
    }

    /*
     * The signup lockup takes its size from the `paragraph` type preset chosen
     * in Admin, which has no mobile variant, so a full-width field and button
     * sat in type larger than the pitch line above them.
     *
     * The button's label comes down to match that line. The *input* text
     * deliberately does not: base.css floors `input.paragraph` at 1rem below
     * 1200px on purpose, because iOS Safari zooms the whole page when a field
     * with sub-16px text takes focus. So the field loses its bulk through its
     * padding instead, which is what made it read oversized anyway. 0.7rem
     * block padding keeps it a ~48px target, above the 44px minimum.
     */
    .section-password .email-signup__button {
      font-size: 0.95rem;
    }

    .section-password .email-signup__input,
    .section-password .email-signup__button {
      padding-block: var(--padding-sm);
    }

    /* Mirrors the countdown eyebrow's own mobile step. */
    .password-follow__heading {
      font-size: calc(var(--font-h1--size) * 0.27);
      letter-spacing: 0.15em;
    }
  }

  /*
   * Short viewports: a phone in landscape, or a small laptop window. The logo
   * block's own mobile size is width-gated (max-width: 750px), so a 844x390
   * phone in landscape takes the *desktop* 192px logo and it fills the whole
   * screen, leaving the countdown cut off at the fold and the signup below it.
   * Capping the image rather than overriding --logo-width keeps the block's
   * aspect ratio intact without repeating it here; the wrapper is a flex row,
   * so it needs the centring the full-width image did not.
   *
   * Capping the logo alone still left the signup ~150px below the fold, so the
   * rest of this block buys that back from the vertical rhythm: the section's
   * own padding, the gaps either side of the countdown, and the lockup's type
   * scale. Every one of these is authored in Admin as an inline custom
   * property, and `spacing-style` consumes those properties in a single-class
   * rule, so overriding the resulting `padding` / `gap` from a more specific
   * selector is what wins here. Overriding the custom properties themselves
   * would not: inline styles set them.
   */
  @media screen and (max-height: 560px) {
    .section-password .section-content-wrapper {
      padding-block: var(--padding-md) var(--padding-md);
      gap: var(--gap-2xs);
    }

    .section-password .logo-block {
      padding-block-end: var(--padding-xs);
    }

    .section-password .logo-block__image-wrapper {
      justify-content: center;
    }

    .section-password .logo-block__image {
      width: auto;
      max-inline-size: 100%;
      max-block-size: 20svh;
    }

    .section-password .launch-countdown {
      font-size: calc(var(--font-h1--size) * 0.78);
    }

    .section-password .text-block {
      padding-block-start: var(--padding-xs);
    }

    /*
     * Two more blocks on a page that already fights for vertical room, so the
     * heading gives its space back here rather than pushing the signup below
     * the fold.
     */
    .password-follow__heading {
      margin-block: var(--margin-2xs) 0;
    }

    /* Outside .section-password: this one lives in layout/password.liquid. */
    .password-enter {
      padding-block: var(--padding-xs);
    }
  }

  .password-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .password-content {
    text-align: center;
  }

  .password-enter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-xl);
  }

  .password-enter__powered-by {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--padding-xs);
    height: 1em;

    a {
      display: flex;
    }

    svg {
      display: inline;
      height: 1.3em;
      color: var(--color-foreground);
    }
  }

  .password-enter__links {
    display: flex;
    align-items: center;
    gap: var(--gap-2xl);

    @media screen and (max-width: 749px) {
      flex-direction: column;
      gap: var(--gap-sm);
    }
  }

  .password-enter__admin-link {
    margin: 0;
  }

  .password-enter__button {
    height: var(--minimum-touch-target);
    background-color: transparent;
    color: var(--color-primary);
    cursor: pointer;
    text-decoration: underline;

    &:hover {
      color: var(--color-primary-hover);
      text-decoration: none;
    }
  }

  /*
   * The dialog lives in layout/password.liquid, outside .section, so it would
   * otherwise inherit :root (the default white scheme) and flash a full-screen
   * white panel over a dark page. Custom properties inherit down the DOM tree
   * regardless of top-layer promotion, so these pick up the values the scheme
   * class on <body> sets. The input inside needs no rule of its own:
   * .field__input already reads --color-input-background / --color-input-text.
   */
  .password-dialog {
    background-color: var(--color-background);
    color: var(--color-foreground);
    max-width: 100vw;
    max-height: 100svh;
    width: 100vw;
    height: 100svh;
    border: none;
    transition: opacity var(--animation-values), display var(--animation-speed) allow-discrete,
      overlay var(--animation-speed) allow-discrete;

    &::backdrop {
      display: none;
    }
  }

  .password-dialog[open] {
    opacity: 1;
    top: 0;
    left: 0;
  }

  @starting-style {
    .password-dialog[open] {
      opacity: 0;
    }
  }

  .password-dialog:not([open]) {
    opacity: 0;
  }

  @starting-style {
    .password-dialog:not([open]) {
      opacity: 1;
    }
  }

  .password-dialog__close-button {
    cursor: pointer;
  }

  .password-dialog__header {
    position: absolute;
    top: 0;
    right: 0;
    padding: var(--padding-lg);
    z-index: var(--layer-raised);
  }

  .password-dialog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--padding-lg);
    height: 100%;
    transition: transform var(--animation-values);
  }

  .password-dialog__content .email-signup__message {
    padding-block-start: var(--padding-xl);
  }

  .password-dialog[open] .password-dialog__content {
    transform: translateY(0);
  }

  @starting-style {
    .password-dialog[open] .password-dialog__content {
      transform: translateY(1em);
    }
  }

  .password-dialog:not([open]) .password-dialog__content {
    transform: translateY(1em);
  }

  @starting-style {
    .password-dialog:not([open]) .password-dialog__content {
      transform: translateY(0);
    }
  }

  .storefront-password-form {
    max-width: 400px;
    width: 100%;
  }

  .email-signup__input-group,
  .password-dialog__submit-button {
    width: 100%;

    @media screen and (min-width: 750px) {
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper section-password",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
