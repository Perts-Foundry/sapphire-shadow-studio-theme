{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<div class="section-background announcement-bar__background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% comment %}
      Starts at "off" and is flipped to "polite" by assets/announcement-bar.js
      when rotation stops. Mirrors the same handling in snippets/slideshow.liquid.
    {% endcomment %}
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="off"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>

    {% if autoplay %}
      {% comment %}
        Pause control for the auto-rotating announcements (WCAG 2.2.2). Two static
        buttons rather than one toggle with a swapping label, matching the pair in
        snippets/slideshow-controls.liquid; the CSS below shows exactly one, keyed
        off the `paused` attribute that assets/announcement-bar.js maintains.
      {% endcomment %}
      <button
        type="button"
        class="slideshow-control announcement-bar__playback button-unstyled icon-pause"
        aria-label="{{ 'accessibility.slideshow_pause' | t }}"
        on:click="/pause"
      >
        {{- 'icon-pause.svg' | inline_asset_content -}}
      </button>
      <button
        type="button"
        class="slideshow-control announcement-bar__playback button-unstyled icon-play"
        aria-label="{{ 'accessibility.slideshow_play' | t }}"
        on:click="/play"
      >
        {{- 'icon-play.svg' | inline_asset_content -}}
      </button>
    {% endif %}
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  /*
   * Animated brand gradient background. The .section aside itself is forced
   * transparent by base.css (.shopify-section:not(.header-section) .section),
   * and the flat color-scheme fill is actually painted by the sibling
   * .section-background div, so the gradient has to live there. Every stop
   * stays dark enough to keep the white text legible (contrast well above
   * 4.5:1). The double class outranks the .color-<scheme> background-color.
   */
  .section-background.announcement-bar__background {
    background-image: linear-gradient(
      90deg,
      #071e3f,
      #123a8c,
      #3a1a6b,
      #6b1a52,
      #0a5563,
      #123a8c,
      #071e3f
    );
    background-size: 300% 100%;
    animation: announcement-bar-gradient 14s ease-in-out infinite;
  }

  @keyframes announcement-bar-gradient {
    0% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-background.announcement-bar__background {
      animation: none;
    }
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  /*
   * Mobile: three button widths of clearance, distributed asymmetrically: one
   * for the previous arrow at the inline start, two at the inline end for the
   * pause control plus the next arrow. Equal auto margins would need four,
   * which costs a whole button width of text and was enough to wrap a one-line
   * announcement onto two lines, making the bar taller. The text ends up half
   * a button width left of geometric centre, which reads as centred there
   * because the width calc binds and the free space on the right genuinely
   * holds one more control than the left.
   *
   * Desktop: the 680px cap binds instead of the width calc, so fixed margins
   * would pin the box (and the text centred inside it) a single button width
   * from the left edge, visibly off-centre. Auto margins centre the capped
   * box; the width calc reserves two button widths per side, which covers the
   * pause-plus-arrow pair on the right even at 750px where the cap stops
   * binding.
   */
  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 3);
    max-width: 680px;
    margin-inline: var(--button-size) calc(var(--button-size) * 2);

    @media screen and (min-width: 750px) {
      width: calc(100% - var(--button-size) * 4);
      margin-inline: auto;
    }
  }

  /*
   * Positioned out of flow for the same reason the arrows are: the control is a
   * full 44px touch target, so as a flow child it became the tallest item in the
   * row and made the whole bar thicker than the announcement text needs. Taking
   * it out of flow returns the bar's height to being driven by its text alone.
   *
   * Offset one button width from the inline end so it sits inboard of the next
   * arrow rather than underneath it. `inset-block: 0` with `margin-block: auto`
   * centres it against whatever height the text ends up producing.
   */
  .announcement-bar__playback {
    position: absolute;
    inset-block: 0;
    inset-inline-end: var(--button-size);
    margin-block: auto;
    color: var(--color-foreground);
    flex-shrink: 0;
    z-index: var(--layer-heightened);
  }

  /* Show exactly one of the pause/play pair; see the markup comment above. */
  announcement-bar-component:not([paused]) .announcement-bar__playback.icon-play,
  announcement-bar-component[paused] .announcement-bar__playback.icon-pause {
    display: none;
  }

  /*
   * base.css hides the svg inside any .icon-pause / .icon-play control and only
   * un-hides it under `slideshow-component[autoplay]`. This is an
   * announcement-bar-component, so without this rule the button renders as a
   * correctly sized, correctly labelled, completely blank box: present in the
   * accessibility tree, invisible on screen.
   */
  announcement-bar-component:not([paused]) .announcement-bar__playback.icon-pause > svg,
  announcement-bar-component[paused] .announcement-bar__playback.icon-play > svg {
    display: block;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  /* The anchor label is visually hidden, so give the anchor itself a visible
     focus ring for keyboard users. */
  .announcement-bar__link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
