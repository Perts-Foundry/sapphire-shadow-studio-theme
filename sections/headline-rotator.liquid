{% comment %}
  TEMPORARY exploration section.

  Option 1 (classic script) is locked in: small tracked lead "We", oversized
  cursive "Obsessed", small tracked tagline "so you don't have to". This
  iteration keeps that treatment fixed and only varies the VERTICAL SPACING of
  the three stacked lines so we can compare density (overlapping, tight, roomy,
  airy, and a couple of asymmetric splits). Manual prev / next controls (arrow
  buttons, or the Left/Right arrow keys) drive it; there is no auto-advance. It
  renders no visible box of its own: it only injects the styles and a small
  script that rewrites the hero <h1> in place, plus a control bar naming the
  current option.

  Remove this section and its entry in templates/index.json once a spacing is
  chosen. Nothing else references it.
{% endcomment %}

<style>
  :root {
    --hlr-script: "Snell Roundhand", "Brush Script MT", "Segoe Script", cursive;
  }

  /* Locked option-1 look; only the gap/margins change per variant. */
  .hero__content-wrapper h1.hlr {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    line-height: 0.9 !important;
    transition: opacity 0.35s ease;
  }
  .hero__content-wrapper h1.hlr .pre {
    font-size: 0.4em;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .hero__content-wrapper h1.hlr .big {
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
    /* Sized in em off the h1's (responsive) base so the whole lockup scales as
       one unit; keeps "Obsessed" proportional to the lead/tagline at every
       width instead of dropping to a viewport-based floor on mobile. */
    font-size: 2.4em;
    line-height: 0.85;
  }
  .hero__content-wrapper h1.hlr .post {
    font-size: 0.34em;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* Symmetric gap ladder (v1 overlaps via negative margins; gap can't be negative) */
  .hero__content-wrapper h1.hlr[data-hlr="v1"] { gap: 0; }
  .hero__content-wrapper h1.hlr[data-hlr="v1"] .big { margin-block: -0.06em; }
  .hero__content-wrapper h1.hlr[data-hlr="v2"] { gap: 0; }
  .hero__content-wrapper h1.hlr[data-hlr="v3"] { gap: 0.05em; }
  .hero__content-wrapper h1.hlr[data-hlr="v4"] { gap: 0.15em; }
  .hero__content-wrapper h1.hlr[data-hlr="v5"] { gap: 0.3em; }
  .hero__content-wrapper h1.hlr[data-hlr="v6"] { gap: 0.5em; }
  .hero__content-wrapper h1.hlr[data-hlr="v7"] { gap: 0.8em; }

  /* Asymmetric splits (gap 0, per-line margins) */
  .hero__content-wrapper h1.hlr[data-hlr="v8"] { gap: 0; }
  .hero__content-wrapper h1.hlr[data-hlr="v8"] .big { margin-block-start: 0.05em; }
  .hero__content-wrapper h1.hlr[data-hlr="v8"] .post { margin-block-start: 0.5em; }

  .hero__content-wrapper h1.hlr[data-hlr="v9"] { gap: 0; }
  .hero__content-wrapper h1.hlr[data-hlr="v9"] .big { margin-block-start: 0.4em; }
  .hero__content-wrapper h1.hlr[data-hlr="v9"] .post { margin-block-start: 0.05em; }

  /* Condensed: tight script line-box, small gap */
  .hero__content-wrapper h1.hlr[data-hlr="v10"] { gap: 0.1em; }
  .hero__content-wrapper h1.hlr[data-hlr="v10"] .big { line-height: 0.7; }

  /* Manual prev / next control bar naming the current option */
  .hlr-controls {
    position: fixed;
    inset-block-end: 24px;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    max-width: 92vw;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .hlr-controls__btn {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.9);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlr-controls__btn:hover {
    background: rgba(7, 30, 63, 1);
  }
  .hlr-controls__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .hlr-controls__label {
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.9);
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlr-controls__label strong {
    font-weight: 700;
  }
</style>

<script>
  (function () {
    var HTML = "<span class=\"pre\">We</span>" +
               "<span class=\"big\">Obsessed</span>" +
               "<span class=\"post\">so you don't have to</span>";

    var VARIANTS = [
      { v: "v1", label: "Overlapping (-0.08em)" },
      { v: "v2", label: "Tight (0)" },
      { v: "v3", label: "Snug (0.05em)" },
      { v: "v4", label: "Balanced (0.15em)" },
      { v: "v5", label: "Roomy (0.3em)" },
      { v: "v6", label: "Airy (0.5em)" },
      { v: "v7", label: "Spacious (0.8em)" },
      { v: "v8", label: "Asymmetric: tight top, open tagline" },
      { v: "v9", label: "Asymmetric: open top, tight tagline" },
      { v: "v10", label: "Condensed script line-box" }
    ];

    function findHeadline() {
      return document.querySelector(".hero__content-wrapper h1") ||
             document.querySelector(".hero h1") ||
             document.querySelector("h1");
    }

    function start() {
      var h1 = findHeadline();
      if (!h1) {
        window.setTimeout(start, 300);
        return;
      }

      h1.classList.add("hlr");
      h1.innerHTML = HTML;

      var controls = document.createElement("div");
      controls.className = "hlr-controls";

      var prev = document.createElement("button");
      prev.type = "button";
      prev.className = "hlr-controls__btn";
      prev.setAttribute("aria-label", "Previous spacing option");
      prev.textContent = "‹";

      var label = document.createElement("div");
      label.className = "hlr-controls__label";
      label.setAttribute("aria-live", "polite");

      var next = document.createElement("button");
      next.type = "button";
      next.className = "hlr-controls__btn";
      next.setAttribute("aria-label", "Next spacing option");
      next.textContent = "›";

      controls.appendChild(prev);
      controls.appendChild(label);
      controls.appendChild(next);
      document.body.appendChild(controls);

      var i = 0;
      function apply() {
        var opt = VARIANTS[i];
        h1.setAttribute("data-hlr", opt.v);
        label.innerHTML = "<strong>" + (i + 1) + " / " + VARIANTS.length +
          "</strong> · " + opt.label;
      }

      function go(step) {
        i = (i + step + VARIANTS.length) % VARIANTS.length;
        apply();
      }

      prev.addEventListener("click", function () { go(-1); });
      next.addEventListener("click", function () { go(1); });
      document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") { go(-1); }
        else if (event.key === "ArrowRight") { go(1); }
      });

      apply();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Headline rotator (temp)",
  "settings": [],
  "presets": [
    {
      "name": "Headline rotator (temp)"
    }
  ]
}
{% endschema %}
