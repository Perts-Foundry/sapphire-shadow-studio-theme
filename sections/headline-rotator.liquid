{% comment %}
  TEMPORARY exploration section.

  Steps the homepage hero headline through a set of typographic treatments so we
  can preview options live on the PR preview theme. This iteration drills into
  the chosen big-word layout (small lead "We", oversized cursive "Obsessed",
  small tagline) and explores permutations of it: focus-word casing/punctuation,
  three script fonts, tagline treatments, and a couple of flourishes. Manual
  prev / next controls (arrow buttons, or the Left/Right arrow keys) drive it;
  there is no auto-advance. It renders no visible box of its own: it only injects
  the styles and a small script that rewrites the hero <h1> in place, plus a
  control bar naming the current option.

  Remove this section and its entry in templates/index.json once a direction is
  chosen. Nothing else references it.
{% endcomment %}

<style>
  :root {
    --hlr-script: "Snell Roundhand", "Brush Script MT", "Segoe Script", cursive;
    --hlr-brush: "Brush Script MT", "Segoe Script", "Snell Roundhand", cursive;
    --hlr-callig: "Apple Chancery", "Lucida Calligraphy", "Palatino Linotype", cursive;
  }

  /* Shared big-word layout for every permutation. */
  .hero__content-wrapper h1.hlr {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
    line-height: 0.9 !important;
    transition: opacity 0.35s ease;
  }
  .hero__content-wrapper h1.hlr .pre {
    font-size: 0.4em;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .hero__content-wrapper h1.hlr .big {
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 0.85;
    position: relative;
  }
  .hero__content-wrapper h1.hlr .post {
    font-size: 0.34em;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* v4: oversized script, smaller lead */
  .hero__content-wrapper h1.hlr[data-hlr="v4"] .big {
    font-size: clamp(3.5rem, 15vw, 9rem);
  }
  .hero__content-wrapper h1.hlr[data-hlr="v4"] .pre {
    font-size: 0.32em;
  }

  /* v5: underline flourish beneath the script word */
  .hero__content-wrapper h1.hlr[data-hlr="v5"] .big::after {
    content: "";
    position: absolute;
    inset-inline: 8%;
    inset-block-end: 0.12em;
    height: 2px;
    background: currentColor;
    opacity: 0.55;
    border-radius: 2px;
  }

  /* v6: brush-forward script */
  .hero__content-wrapper h1.hlr[data-hlr="v6"] .big {
    font-family: var(--hlr-brush) !important;
  }

  /* v7: formal calligraphy */
  .hero__content-wrapper h1.hlr[data-hlr="v7"] .big {
    font-family: var(--hlr-callig) !important;
  }

  /* v9: soft accent-font italic tagline instead of tracked caps */
  .hero__content-wrapper h1.hlr[data-hlr="v9"] .post {
    font-family: var(--font-accent--family) !important;
    font-style: italic !important;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.4em;
    opacity: 0.95;
  }

  /* v10: signed feel, slight rotation */
  .hero__content-wrapper h1.hlr[data-hlr="v10"] {
    gap: 0.12em;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v10"] .big {
    transform: rotate(-3deg);
  }

  /* Manual prev / next control bar naming the current option */
  .hlr-controls {
    position: fixed;
    inset-block-end: 24px;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    max-width: 92vw;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .hlr-controls__btn {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.9);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlr-controls__btn:hover {
    background: rgba(7, 30, 63, 1);
  }
  .hlr-controls__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .hlr-controls__label {
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.9);
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlr-controls__label strong {
    font-weight: 700;
  }
</style>

<script>
  (function () {
    function bigWord(pre, word, post) {
      return "<span class=\"pre\">" + pre + "</span>" +
             "<span class=\"big\">" + word + "</span>" +
             "<span class=\"post\">" + post + "</span>";
    }

    var LEAD = "We";
    var TAIL = "so you don't have to";

    var VARIANTS = [
      { v: "v1", label: "Classic script", html: bigWord(LEAD, "Obsessed", TAIL) },
      { v: "v2", label: "Lowercase focus word", html: bigWord(LEAD, "obsessed", TAIL) },
      { v: "v3", label: "With a period", html: bigWord(LEAD, "Obsessed.", TAIL) },
      { v: "v4", label: "Oversized script", html: bigWord(LEAD, "Obsessed", TAIL) },
      { v: "v5", label: "Underlined flourish", html: bigWord(LEAD, "Obsessed", TAIL) },
      { v: "v6", label: "Brush script font", html: bigWord(LEAD, "Obsessed", TAIL) },
      { v: "v7", label: "Calligraphy font", html: bigWord(LEAD, "Obsessed", TAIL) },
      { v: "v8", label: "Contraction: We're obsessed", html: bigWord("We're", "obsessed", TAIL) },
      { v: "v9", label: "Soft accent tagline", html: bigWord(LEAD, "Obsessed", TAIL) },
      { v: "v10", label: "Signed / skewed", html: bigWord(LEAD, "Obsessed", TAIL) }
    ];

    function findHeadline() {
      return document.querySelector(".hero__content-wrapper h1") ||
             document.querySelector(".hero h1") ||
             document.querySelector("h1");
    }

    function start() {
      var h1 = findHeadline();
      if (!h1) {
        window.setTimeout(start, 300);
        return;
      }

      h1.classList.add("hlr");

      var controls = document.createElement("div");
      controls.className = "hlr-controls";

      var prev = document.createElement("button");
      prev.type = "button";
      prev.className = "hlr-controls__btn";
      prev.setAttribute("aria-label", "Previous headline option");
      prev.textContent = "‹";

      var label = document.createElement("div");
      label.className = "hlr-controls__label";
      label.setAttribute("aria-live", "polite");

      var next = document.createElement("button");
      next.type = "button";
      next.className = "hlr-controls__btn";
      next.setAttribute("aria-label", "Next headline option");
      next.textContent = "›";

      controls.appendChild(prev);
      controls.appendChild(label);
      controls.appendChild(next);
      document.body.appendChild(controls);

      var i = 0;
      function apply() {
        var opt = VARIANTS[i];
        h1.style.opacity = "0";
        window.setTimeout(function () {
          h1.setAttribute("data-hlr", opt.v);
          h1.innerHTML = opt.html;
          h1.style.opacity = "1";
        }, 180);
        label.innerHTML = "<strong>" + (i + 1) + " / " + VARIANTS.length +
          "</strong> · " + opt.label;
      }

      function go(step) {
        i = (i + step + VARIANTS.length) % VARIANTS.length;
        apply();
      }

      prev.addEventListener("click", function () { go(-1); });
      next.addEventListener("click", function () { go(1); });
      document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") { go(-1); }
        else if (event.key === "ArrowRight") { go(1); }
      });

      apply();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Headline rotator (temp)",
  "settings": [],
  "presets": [
    {
      "name": "Headline rotator (temp)"
    }
  ]
}
{% endschema %}
