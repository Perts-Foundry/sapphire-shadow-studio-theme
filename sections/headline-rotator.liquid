{% comment %}
  TEMPORARY exploration section.

  Steps the homepage hero headline through a set of typographic treatments so we
  can preview options live on the PR preview theme. This iteration focuses on the
  chosen direction: a cursive/accent-font emphasis on "Obsessed" inside stacked
  and big-word layouts, across several fonts. Manual prev / next controls (arrow
  buttons, or the Left/Right arrow keys) drive it; there is no auto-advance. It
  renders no visible box of its own: it only injects the styles and a small script
  that rewrites the hero <h1> in place, plus a control bar naming the current
  option.

  Remove this section and its entry in templates/index.json once a direction is
  chosen. Nothing else references it.
{% endcomment %}

<style>
  :root {
    /* Three script/handwriting stacks so we can compare cursive personalities.
       Each renders a script face on macOS and Windows, then falls back generic. */
    --hlr-script: "Snell Roundhand", "Brush Script MT", "Segoe Script", cursive;
    --hlr-hand: "Ink Free", "Segoe Print", "Bradley Hand", cursive;
    --hlr-callig: "Apple Chancery", "Lucida Calligraphy", "Palatino Linotype", cursive;
  }

  .hero__content-wrapper h1.hlr {
    transition: opacity 0.35s ease;
  }

  /* Shared big-word layout: small lead, oversized focus word, small tagline. */
  .hero__content-wrapper h1.hlr[data-hlr="v2"],
  .hero__content-wrapper h1.hlr[data-hlr="v4"],
  .hero__content-wrapper h1.hlr[data-hlr="v5"],
  .hero__content-wrapper h1.hlr[data-hlr="v6"],
  .hero__content-wrapper h1.hlr[data-hlr="v7"],
  .hero__content-wrapper h1.hlr[data-hlr="v9"],
  .hero__content-wrapper h1.hlr[data-hlr="v10"] {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
    line-height: 0.9 !important;
  }
  .hero__content-wrapper h1.hlr .pre {
    font-size: 0.4em;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .hero__content-wrapper h1.hlr .big {
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 0.85;
  }
  .hero__content-wrapper h1.hlr .post {
    font-size: 0.34em;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* v1: two-line stack, cursive script "obsessed" */
  .hero__content-wrapper h1.hlr[data-hlr="v1"] {
    line-height: 1.05 !important;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v1"] .obs {
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
    font-size: 1.3em;
  }

  /* v2: big word, cursive script */
  .hero__content-wrapper h1.hlr[data-hlr="v2"] .big {
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
  }

  /* v3: two-line stack, accent font italic "obsessed" (no cursive) */
  .hero__content-wrapper h1.hlr[data-hlr="v3"] {
    line-height: 1.05 !important;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v3"] .obs {
    font-family: var(--font-accent--family) !important;
    font-style: italic !important;
    font-size: 1.12em;
  }

  /* v4: big word, heading font uppercase, bold (structural, no cursive) */
  .hero__content-wrapper h1.hlr[data-hlr="v4"] .big {
    font-family: var(--font-heading--family) !important;
    font-weight: 800 !important;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(2.75rem, 11vw, 6.25rem);
  }

  /* v5: big word, handwriting/print script */
  .hero__content-wrapper h1.hlr[data-hlr="v5"] .big {
    font-family: var(--hlr-hand) !important;
    font-weight: 400 !important;
  }

  /* v6: big word, formal calligraphy */
  .hero__content-wrapper h1.hlr[data-hlr="v6"] .big {
    font-family: var(--hlr-callig) !important;
    font-weight: 400 !important;
  }

  /* v7: three-line editorial, script word + small-caps subheading tagline */
  .hero__content-wrapper h1.hlr[data-hlr="v7"] {
    gap: 0.18em;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v7"] .big {
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v7"] .post {
    font-family: var(--font-subheading--family) !important;
    font-variant: small-caps;
    text-transform: none;
    letter-spacing: 0.16em;
    font-size: 0.32em;
  }

  /* v8: two-line stack, cursive script on the tagline tail */
  .hero__content-wrapper h1.hlr[data-hlr="v8"] {
    line-height: 1.05 !important;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v8"] .tail {
    display: inline-block;
    margin-block-start: 0.08em;
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
    font-size: 1.2em;
  }

  /* v9: big word script + accent-font italic tagline (softer, not uppercase) */
  .hero__content-wrapper h1.hlr[data-hlr="v9"] .big {
    font-family: var(--hlr-script) !important;
    font-weight: 400 !important;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v9"] .post {
    font-family: var(--font-accent--family) !important;
    font-style: italic !important;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.4em;
    opacity: 0.95;
  }

  /* v10: big calligraphy word between tightly tracked uppercase lines */
  .hero__content-wrapper h1.hlr[data-hlr="v10"] .big {
    font-family: var(--hlr-callig) !important;
    font-weight: 400 !important;
  }
  .hero__content-wrapper h1.hlr[data-hlr="v10"] .pre,
  .hero__content-wrapper h1.hlr[data-hlr="v10"] .post {
    letter-spacing: 0.4em;
    font-size: 0.3em;
    opacity: 0.9;
  }

  /* Manual prev / next control bar naming the current option */
  .hlr-controls {
    position: fixed;
    inset-block-end: 24px;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    max-width: 92vw;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .hlr-controls__btn {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.9);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlr-controls__btn:hover {
    background: rgba(7, 30, 63, 1);
  }
  .hlr-controls__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .hlr-controls__label {
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.9);
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlr-controls__label strong {
    font-weight: 700;
  }
</style>

<script>
  (function () {
    var STACK = "We <span class=\"obs\">obsessed</span>,<br>so you don't have to";
    var STACK_TAIL = "We obsessed,<br><span class=\"tail\">so you don't have to</span>";
    var BIGWORD = "<span class=\"pre\">We</span><span class=\"big\">Obsessed</span><span class=\"post\">so you don't have to</span>";

    var VARIANTS = [
      { v: "v1", label: "Two-line stack · cursive script", html: STACK },
      { v: "v2", label: "Big word · cursive script", html: BIGWORD },
      { v: "v3", label: "Two-line stack · accent font italic", html: STACK },
      { v: "v4", label: "Big word · heading uppercase", html: BIGWORD },
      { v: "v5", label: "Big word · handwriting script", html: BIGWORD },
      { v: "v6", label: "Big word · calligraphy", html: BIGWORD },
      { v: "v7", label: "Three-line editorial · script + small caps", html: BIGWORD },
      { v: "v8", label: "Two-line stack · cursive tail", html: STACK_TAIL },
      { v: "v9", label: "Big word · script + accent tagline", html: BIGWORD },
      { v: "v10", label: "Big word · calligraphy + tracked caps", html: BIGWORD }
    ];

    function findHeadline() {
      return document.querySelector(".hero__content-wrapper h1") ||
             document.querySelector(".hero h1") ||
             document.querySelector("h1");
    }

    function start() {
      var h1 = findHeadline();
      if (!h1) {
        window.setTimeout(start, 300);
        return;
      }

      h1.classList.add("hlr");

      var controls = document.createElement("div");
      controls.className = "hlr-controls";

      var prev = document.createElement("button");
      prev.type = "button";
      prev.className = "hlr-controls__btn";
      prev.setAttribute("aria-label", "Previous headline option");
      prev.textContent = "‹";

      var label = document.createElement("div");
      label.className = "hlr-controls__label";
      label.setAttribute("aria-live", "polite");

      var next = document.createElement("button");
      next.type = "button";
      next.className = "hlr-controls__btn";
      next.setAttribute("aria-label", "Next headline option");
      next.textContent = "›";

      controls.appendChild(prev);
      controls.appendChild(label);
      controls.appendChild(next);
      document.body.appendChild(controls);

      var i = 0;
      function apply() {
        var opt = VARIANTS[i];
        h1.style.opacity = "0";
        window.setTimeout(function () {
          h1.setAttribute("data-hlr", opt.v);
          h1.innerHTML = opt.html;
          h1.style.opacity = "1";
        }, 180);
        label.innerHTML = "<strong>" + (i + 1) + " / " + VARIANTS.length +
          "</strong> · " + opt.label;
      }

      function go(step) {
        i = (i + step + VARIANTS.length) % VARIANTS.length;
        apply();
      }

      prev.addEventListener("click", function () { go(-1); });
      next.addEventListener("click", function () { go(1); });
      document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") { go(-1); }
        else if (event.key === "ArrowRight") { go(1); }
      });

      apply();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Headline rotator (temp)",
  "settings": [],
  "presets": [
    {
      "name": "Headline rotator (temp)"
    }
  ]
}
{% endschema %}
