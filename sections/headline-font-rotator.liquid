{% comment %}
  TEMPORARY exploration section.

  Yesteryear is the chosen face; this now cycles the hero lockup's "Obsessed"
  word through faux-bold TREATMENTS of Yesteryear (stroke-based and shadow-based,
  light to heavy, plus a bigger+bold option) so we can dial in the weight that
  best matches the (proprietary, unembeddable) Brush Script MT look. Manual
  prev / next controls (arrow buttons, or the Left/Right arrow keys) drive it;
  there is no auto-advance. It injects the candidate @font-face rules plus a
  small script that restyles .hero-lockup__word in place, and a control bar
  naming the current treatment.

  When a treatment is chosen: bake it into .hero-lockup__word in hero.liquid,
  delete this section and its templates/index.json entry, and sweep the
  assets/tmp-*.woff2 files (keeping only the chosen face). Nothing else
  references this.
{% endcomment %}

<style>
  @font-face { font-family: "Yesteryear"; src: url("{{ 'tmp-yesteryear.woff2' | asset_url }}") format("woff2"); font-display: swap; }

  .hlrf-controls {
    position: fixed;
    inset-block-end: 24px;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    max-width: 92vw;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .hlrf-controls__btn {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.92);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlrf-controls__btn:hover { background: rgba(7, 30, 63, 1); }
  .hlrf-controls__btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hlrf-controls__label {
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.92);
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlrf-controls__label strong { font-weight: 700; }
</style>

<script>
  (function () {
    // Multi-direction same-colour text-shadow: a faux-bold that thickens the
    // glyph evenly. v is the spread in em (scales with the word's font-size).
    function shadowBold(v) {
      var d = v + "em";
      var dd = (v * 0.72).toFixed(4) + "em";
      return [
        d + " 0", "-" + d + " 0", "0 " + d, "0 -" + d,
        dd + " " + dd, "-" + dd + " -" + dd, dd + " -" + dd, "-" + dd + " " + dd
      ].map(function (o) { return o + " currentColor"; }).join(", ");
    }

    // All variants render Yesteryear; they differ only in the faux-bold
    // treatment (stroke = -webkit-text-stroke width; shadow = shadowBold spread)
    // and size (em off the 2em base).
    var FONTS = [
      { label: "1. Regular (no bold)", stroke: 0, shadow: "", size: "2em" },
      { label: "2. Stroke light (0.008em)", stroke: "0.008em", shadow: "", size: "2em" },
      { label: "3. Stroke medium (0.014em)", stroke: "0.014em", shadow: "", size: "2em" },
      { label: "4. Stroke heavy (0.022em)", stroke: "0.022em", shadow: "", size: "2em" },
      { label: "5. Shadow medium (0.012em)", stroke: 0, shadow: shadowBold(0.012), size: "2em" },
      { label: "6. Shadow heavy (0.018em)", stroke: 0, shadow: shadowBold(0.018), size: "2em" },
      { label: "7. Bigger + stroke (2.2em, 0.014em)", stroke: "0.014em", shadow: "", size: "2.2em" }
    ];

    function findWord() {
      return document.querySelector(".hero-lockup__word");
    }

    function start() {
      var word = findWord();
      if (!word) {
        window.setTimeout(start, 300);
        return;
      }

      var controls = document.createElement("div");
      controls.className = "hlrf-controls";

      var prev = document.createElement("button");
      prev.type = "button";
      prev.className = "hlrf-controls__btn";
      prev.setAttribute("aria-label", "Previous font");
      prev.textContent = "‹";

      var label = document.createElement("div");
      label.className = "hlrf-controls__label";
      label.setAttribute("aria-live", "polite");

      var next = document.createElement("button");
      next.type = "button";
      next.className = "hlrf-controls__btn";
      next.setAttribute("aria-label", "Next font");
      next.textContent = "›";

      controls.appendChild(prev);
      controls.appendChild(label);
      controls.appendChild(next);
      document.body.appendChild(controls);

      var i = 0;
      function apply() {
        var opt = FONTS[i];
        word.style.fontFamily = "\"Yesteryear\", cursive";
        word.style.fontSize = opt.size;
        word.style.webkitTextStroke = opt.stroke ? opt.stroke + " currentColor" : "";
        word.style.textShadow = opt.shadow;
        label.innerHTML = "<strong>" + (i + 1) + " / " + FONTS.length + "</strong> · " + opt.label;
      }
      function go(step) {
        i = (i + step + FONTS.length) % FONTS.length;
        apply();
      }

      prev.addEventListener("click", function () { go(-1); });
      next.addEventListener("click", function () { go(1); });
      document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") { go(-1); }
        else if (event.key === "ArrowRight") { go(1); }
      });

      apply();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Font rotator (temp)",
  "settings": [],
  "presets": [
    {
      "name": "Font rotator (temp)"
    }
  ]
}
{% endschema %}
