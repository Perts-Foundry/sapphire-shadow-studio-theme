  .hlrf-controls {
    position: fixed;
    inset-block-end: 24px;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    max-width: 92vw;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .hlrf-controls__btn {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.92);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlrf-controls__btn:hover { background: rgba(7, 30, 63, 1); }
  .hlrf-controls__btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hlrf-controls__label {
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.92);
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlrf-controls__label strong { font-weight: 700; }
