<script>
  (function () {
    var FONTS = [
      { label: "1. Damion [A]", family: "\"Damion\", cursive" },
      { label: "2. Norican [A]", family: "\"Norican\", cursive" },
      { label: "3. Kaushan Script [A]", family: "\"Kaushan Script\", cursive" },
      { label: "4. Yellowtail [A]", family: "\"Yellowtail\", cursive" },
      { label: "5. Satisfy [A]", family: "\"Satisfy\", cursive" },
      { label: "6. Pacifico [A]", family: "\"Pacifico\", cursive" },
      { label: "7. Courgette [A]", family: "\"Courgette\", cursive" },
      { label: "8. Grand Hotel [A]", family: "\"Grand Hotel\", cursive" },
      { label: "9. Merienda [A]", family: "\"Merienda\", cursive" },
      { label: "10. Caveat Brush [A]", family: "\"Caveat Brush\", cursive" },
      { label: "11. Fasthand [A]", family: "\"Fasthand\", cursive" },
      { label: "12. Comforter Brush [A]", family: "\"Comforter Brush\", cursive" },
      { label: "13. Water Brush [A]", family: "\"Water Brush\", cursive" },
      { label: "14. Vujahday Script [A]", family: "\"Vujahday Script\", cursive" },
      { label: "15. Sriracha [A]", family: "\"Sriracha\", cursive" },
      { label: "16. Sassy Frass [A]", family: "\"Sassy Frass\", cursive" },
      { label: "17. Lobster Two [A]", family: "\"Lobster Two\", cursive" },
      { label: "18. Yesteryear [B]", family: "\"Yesteryear\", cursive" },
      { label: "19. Cookie [B]", family: "\"Cookie\", cursive" },
      { label: "20. Sofia [B]", family: "\"Sofia\", cursive" },
      { label: "21. Niconne [B]", family: "\"Niconne\", cursive" },
      { label: "22. Marck Script [B]", family: "\"Marck Script\", cursive" },
      { label: "23. Bad Script [B]", family: "\"Bad Script\", cursive" },
      { label: "24. Kristi [B]", family: "\"Kristi\", cursive" },
      { label: "25. Handlee [B]", family: "\"Handlee\", cursive" },
      { label: "26. Gochi Hand [B]", family: "\"Gochi Hand\", cursive" },
      { label: "27. Sue Ellen Francisco [B]", family: "\"Sue Ellen Francisco\", cursive" },
      { label: "28. Dancing Script [C]", family: "\"Dancing Script\", cursive" },
      { label: "29. Great Vibes [C]", family: "\"Great Vibes\", cursive" },
      { label: "30. Alex Brush [C]", family: "\"Alex Brush\", cursive" },
      { label: "31. Allura [C]", family: "\"Allura\", cursive" },
      { label: "32. Sacramento [C]", family: "\"Sacramento\", cursive" },
      { label: "33. Parisienne [C]", family: "\"Parisienne\", cursive" },
      { label: "34. Rochester [C]", family: "\"Rochester\", cursive" },
      { label: "35. Clicker Script [C]", family: "\"Clicker Script\", cursive" },
      { label: "36. Mr Dafoe [C]", family: "\"Mr Dafoe\", cursive" },
      { label: "37. Rouge Script [C]", family: "\"Rouge Script\", cursive" },
      { label: "38. Style Script [C]", family: "\"Style Script\", cursive" },
      { label: "39. Moon Dance [C]", family: "\"Moon Dance\", cursive" },
      { label: "40. Estonia [C]", family: "\"Estonia\", cursive" },
      { label: "41. Tangerine [D]", family: "\"Tangerine\", cursive" },
      { label: "42. Pinyon Script [D]", family: "\"Pinyon Script\", cursive" },
      { label: "43. Petit Formal Script [D]", family: "\"Petit Formal Script\", cursive" },
      { label: "44. Italianno [D]", family: "\"Italianno\", cursive" },
      { label: "45. Herr Von Muellerhoff [D]", family: "\"Herr Von Muellerhoff\", cursive" },
      { label: "46. Mrs Saint Delafield [D]", family: "\"Mrs Saint Delafield\", cursive" },
      { label: "47. Ephesis [D]", family: "\"Ephesis\", cursive" },
      { label: "48. Bonheur Royale [D]", family: "\"Bonheur Royale\", cursive" },
      { label: "49. Corinthia [D]", family: "\"Corinthia\", cursive" },
      { label: "50. WindSong [D]", family: "\"WindSong\", cursive" }
    ];

    function findWord() {
      return document.querySelector(".hero-lockup__word");
    }

    function start() {
      var word = findWord();
      if (!word) {
        window.setTimeout(start, 300);
        return;
      }

      var controls = document.createElement("div");
      controls.className = "hlrf-controls";

      var prev = document.createElement("button");
      prev.type = "button";
      prev.className = "hlrf-controls__btn";
      prev.setAttribute("aria-label", "Previous font");
      prev.textContent = "‹";

      var label = document.createElement("div");
      label.className = "hlrf-controls__label";
      label.setAttribute("aria-live", "polite");

      var next = document.createElement("button");
      next.type = "button";
      next.className = "hlrf-controls__btn";
      next.setAttribute("aria-label", "Next font");
      next.textContent = "›";

      controls.appendChild(prev);
      controls.appendChild(label);
      controls.appendChild(next);
      document.body.appendChild(controls);

      var i = 0;
      function apply() {
        var opt = FONTS[i];
        // Raw face only this pass: clear any faux-bold and reset size.
        word.style.fontFamily = opt.family;
        word.style.fontSize = "2em";
        word.style.webkitTextStroke = "";
        word.style.textShadow = "";
        label.innerHTML = "<strong>" + (i + 1) + " / " + FONTS.length + "</strong> · " + opt.label;
      }
      function go(step) {
        i = (i + step + FONTS.length) % FONTS.length;
        apply();
      }

      prev.addEventListener("click", function () { go(-1); });
      next.addEventListener("click", function () { go(1); });
      document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") { go(-1); }
        else if (event.key === "ArrowRight") { go(1); }
      });

      apply();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

