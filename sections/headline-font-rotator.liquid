{% comment %}
  TEMPORARY exploration section.

  Compares a 5-face shortlist for the hero lockup's "Obsessed" word and lets us
  dial in the weight of each, live on the PR preview, to find the closest match
  to the (proprietary, unembeddable) Brush Script MT look. All five are
  open-licensed Google Fonts (OFL / Apache-2.0), staged as assets/tmp-*.woff2.

  Two axes:
    - Font: the ‹ / › buttons or the Left / Right arrow keys (5 faces).
    - Weight: the - / + buttons or the Down / Up arrow keys.

  Dancing Script and WindSong carry real designed weights (Dancing Script is a
  400-700 variable file; WindSong ships 400 and 500), so their weight steps set
  a genuine font-weight. Yesteryear, Cookie, and Alex Brush are 400-only faces,
  so their heavier steps are faux-bold: -webkit-text-stroke, or a multi-direction
  same-colour text-shadow.

  When a face + weight is chosen: fetch that face's full (non-subset) woff2, bake
  the exact treatment into .hero-lockup__word in hero.liquid with its
  OFL/Apache license in assets/, delete this section and its templates/index.json
  entry, and sweep all assets/tmp-*.woff2. Nothing else references this.
{% endcomment %}

<style>
  @font-face { font-family: "Yesteryear"; src: url("{{ 'tmp-yesteryear.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Cookie"; src: url("{{ 'tmp-cookie.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Dancing Script"; src: url("{{ 'tmp-dancing-script-var.woff2' | asset_url }}") format("woff2"); font-weight: 400 700; font-display: swap; }
  @font-face { font-family: "Alex Brush"; src: url("{{ 'tmp-alex-brush.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "WindSong"; src: url("{{ 'tmp-windsong-400.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "WindSong"; src: url("{{ 'tmp-windsong-500.woff2' | asset_url }}") format("woff2"); font-weight: 500; font-display: swap; }

  .hlrf-controls {
    position: fixed;
    inset-block-end: 24px;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    max-width: 92vw;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }
  .hlrf-controls__btn {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.92);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlrf-controls__btn:hover { background: rgba(7, 30, 63, 1); }
  .hlrf-controls__btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hlrf-controls__label {
    min-width: 0;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7, 30, 63, 0.92);
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .hlrf-controls__label strong { font-weight: 700; }
</style>

<script>
  (function () {
    // Multi-direction same-colour text-shadow: a faux-bold that thickens the
    // glyph evenly. v is the spread in em (scales with the word's font-size).
    function shadowBold(v) {
      var d = v + "em";
      var dd = (v * 0.72).toFixed(4) + "em";
      return [
        d + " 0", "-" + d + " 0", "0 " + d, "0 -" + d,
        dd + " " + dd, "-" + dd + " -" + dd, dd + " -" + dd, "-" + dd + " " + dd
      ].map(function (o) { return o + " currentColor"; }).join(", ");
    }

    // Faux-bold ladder for 400-only faces (real weight unavailable).
    function fauxWeights() {
      return [
        { wl: "regular", weight: 400, stroke: "", shadow: "" },
        { wl: "faux light (0.008em)", weight: 400, stroke: "0.008em", shadow: "" },
        { wl: "faux medium (0.014em)", weight: 400, stroke: "0.014em", shadow: "" },
        { wl: "faux heavy (0.020em)", weight: 400, stroke: "0.020em", shadow: "" },
        { wl: "shadow bold (0.014em)", weight: 400, stroke: "", shadow: shadowBold(0.014) }
      ];
    }

    var FONTS = [
      { name: "Yesteryear", family: "\"Yesteryear\", cursive", weights: fauxWeights() },
      { name: "Cookie", family: "\"Cookie\", cursive", weights: fauxWeights() },
      { name: "Dancing Script", family: "\"Dancing Script\", cursive", weights: [
        { wl: "400 (regular)", weight: 400, stroke: "", shadow: "" },
        { wl: "500", weight: 500, stroke: "", shadow: "" },
        { wl: "600", weight: 600, stroke: "", shadow: "" },
        { wl: "700 (bold)", weight: 700, stroke: "", shadow: "" },
        { wl: "700 + faux (0.010em)", weight: 700, stroke: "0.010em", shadow: "" }
      ] },
      { name: "Alex Brush", family: "\"Alex Brush\", cursive", weights: fauxWeights() },
      { name: "WindSong", family: "\"WindSong\", cursive", weights: [
        { wl: "400 (regular)", weight: 400, stroke: "", shadow: "" },
        { wl: "500 (medium)", weight: 500, stroke: "", shadow: "" },
        { wl: "500 + faux (0.010em)", weight: 500, stroke: "0.010em", shadow: "" },
        { wl: "500 + faux (0.016em)", weight: 500, stroke: "0.016em", shadow: "" },
        { wl: "shadow bold (0.014em)", weight: 400, stroke: "", shadow: shadowBold(0.014) }
      ] }
    ];

    function findWord() {
      return document.querySelector(".hero-lockup__word");
    }

    function mkBtn(glyph, aria) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "hlrf-controls__btn";
      b.setAttribute("aria-label", aria);
      b.textContent = glyph;
      return b;
    }

    function start() {
      var word = findWord();
      if (!word) {
        window.setTimeout(start, 300);
        return;
      }

      var controls = document.createElement("div");
      controls.className = "hlrf-controls";

      var fontPrev = mkBtn("‹", "Previous font");
      var fontNext = mkBtn("›", "Next font");
      var weightDown = mkBtn("−", "Lighter weight");
      var weightUp = mkBtn("+", "Bolder weight");

      var label = document.createElement("div");
      label.className = "hlrf-controls__label";
      label.setAttribute("aria-live", "polite");

      controls.appendChild(fontPrev);
      controls.appendChild(fontNext);
      controls.appendChild(label);
      controls.appendChild(weightDown);
      controls.appendChild(weightUp);
      document.body.appendChild(controls);

      var fi = 0;
      var wi = 0;
      function apply() {
        var f = FONTS[fi];
        if (wi > f.weights.length - 1) { wi = f.weights.length - 1; }
        var w = f.weights[wi];
        word.style.fontFamily = f.family;
        word.style.fontWeight = w.weight;
        word.style.fontSize = "2em";
        word.style.webkitTextStroke = w.stroke ? w.stroke + " currentColor" : "";
        word.style.textShadow = w.shadow;
        label.innerHTML =
          "<strong>Font " + (fi + 1) + "/" + FONTS.length + "</strong> " + f.name +
          " &middot; <strong>W " + (wi + 1) + "/" + f.weights.length + "</strong> " + w.wl;
      }
      function goFont(step) {
        fi = (fi + step + FONTS.length) % FONTS.length;
        wi = Math.min(wi, FONTS[fi].weights.length - 1);
        apply();
      }
      function goWeight(step) {
        var len = FONTS[fi].weights.length;
        wi = (wi + step + len) % len;
        apply();
      }

      fontPrev.addEventListener("click", function () { goFont(-1); });
      fontNext.addEventListener("click", function () { goFont(1); });
      weightDown.addEventListener("click", function () { goWeight(-1); });
      weightUp.addEventListener("click", function () { goWeight(1); });
      document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") { goFont(-1); }
        else if (event.key === "ArrowRight") { goFont(1); }
        else if (event.key === "ArrowUp") { event.preventDefault(); goWeight(1); }
        else if (event.key === "ArrowDown") { event.preventDefault(); goWeight(-1); }
      });

      apply();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Font rotator (temp)",
  "settings": [],
  "presets": [
    {
      "name": "Font rotator (temp)"
    }
  ]
}
{% endschema %}
