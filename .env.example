# Copy to .env (gitignored) and fill in. Read explicitly: node --env-file=.env scripts/<tool>.mjs
# Admin API credentials for the custom app; the access token is minted at runtime from these and is
# never printed, committed, or stored. See scripts/README.md > Credentials.
MYSHOPIFY_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Storefront password while the store is locked; read by the storefront-facing tools only
# (site-check probe and tools runner, seo-review crawl, the a11y cookie helper). Delete at launch.
STOREFRONT_PASSWORD=
